<Item class="Script" referent="RBX66C1625455D04AC580D8100481513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">death</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local npc = script.Parent
local humanoid = npc:FindFirstChildOfClass("Humanoid")
local TweenService = game:GetService("TweenService")

local function fadeAndDestroy()
    wait(2) 
    
    for _, part in ipairs(npc:GetDescendants()) do
        if part:IsA("BasePart") then
            local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
            local goal = {Transparency = 1}
            local tween = TweenService:Create(part, tweenInfo, goal)
            tween:Play()
        end
    end
end
humanoid.Died:Connect(fadeAndDestroy)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8004820041fa</UniqueId>
