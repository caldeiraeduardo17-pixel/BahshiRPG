<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
 
local player = Players.LocalPlayer
local renascer = ReplicatedStorage:WaitForChild("Renascer")
 
-- ===== CONFIGURAÇÕES =====
local TEXTO = "Você Morreu"
local TEXTO_BOTAO = "Renascer"
local COR_TEXTO = Color3.fromRGB(200, 40, 40)
local ATRASO = 1.5
-- =========================
 
local gui = Instance.new("ScreenGui")
gui.Name = "TelaMorte"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 100
gui.Parent = player:WaitForChild("PlayerGui")
 
local fundo = Instance.new("Frame")
fundo.Visible = false
fundo.Active = true
fundo.Size = UDim2.new(1, 0, 1, 0)
fundo.BackgroundColor3 = Color3.new(0, 0, 0)
fundo.BackgroundTransparency = 1
fundo.BorderSizePixel = 0
fundo.Parent = gui
 
local titulo = Instance.new("TextLabel")
titulo.AnchorPoint = Vector2.new(0.5, 0.5)
titulo.Position = UDim2.new(0.5, 0, 0.4, 0)
titulo.Size = UDim2.new(0.8, 0, 0, 80)
titulo.BackgroundTransparency = 1
titulo.Text = TEXTO
titulo.TextColor3 = COR_TEXTO
titulo.TextStrokeTransparency = 0.3
titulo.Font = Enum.Font.GothamBlack
titulo.TextScaled = true
titulo.TextTransparency = 1
titulo.Parent = fundo
 
local botao = Instance.new("TextButton")
botao.AnchorPoint = Vector2.new(0.5, 0.5)
botao.Position = UDim2.new(0.5, 0, 0.58, 0)
botao.Size = UDim2.new(0, 200, 0, 50)
botao.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
botao.BorderSizePixel = 0
botao.Text = TEXTO_BOTAO
botao.TextColor3 = Color3.new(1, 1, 1)
botao.Font = Enum.Font.GothamBold
botao.TextSize = 24
botao.TextTransparency = 1
botao.BackgroundTransparency = 1
botao.Parent = fundo
 
local mostrando = false
 
-- solta o mouse (no PC, a mira prende o mouse no centro da tela)
local function liberarMouse()
    if not UserInputService.TouchEnabled then
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end
 
local function esconder()
    mostrando = false
    fundo.Visible = false
    fundo.BackgroundTransparency = 1
    titulo.TextTransparency = 1
    botao.TextTransparency = 1
    botao.BackgroundTransparency = 1
end
 
local function mostrar()
    mostrando = true
    liberarMouse()
    fundo.Visible = true
    
    local info = TweenInfo.new(0.8)
    TweenService:Create(fundo, info, {BackgroundTransparency = 0.4}):Play()
    TweenService:Create(titulo, info, {TextTransparency = 0}):Play()
    TweenService:Create(botao, info, {TextTransparency = 0, BackgroundTransparency = 0}):Play()
end
 
botao.Activated:Connect(function()
    esconder()
    renascer:FireServer()
end)
 
player.CharacterAdded:Connect(esconder)
 
-- olha a vida do personagem o tempo todo
local jaMostrou = nil
 
task.spawn(function()
    while true do
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if mostrando then
            liberarMouse() -- garante o mouse livre enquanto a tela de morte está aberta
        end
        
        if hum then
            if hum.Health <= 0 then
                if jaMostrou ~= hum then
                    jaMostrou = hum
                    task.delay(ATRASO, function()
                        if hum.Health <= 0 then
                            mostrar()
                        end
                    end)
                end
            elseif mostrando then
                esconder()
            end
        end
        
        task.wait(0.2)
    end
end)

]]></ProtectedString>
