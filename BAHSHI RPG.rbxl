</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8103333513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Loot</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
 
-- ===== CONFIGURAÇÕES =====
local PORCENTAGEM = 0.3     -- 30% dos itens e do ouro
local TEMPO_DONO = 300      -- segundos só pro dono (5 min) 
local TEMPO_SUMIR = 900     -- segundos até a mochila sumir (15 min, contando desde a morte)
local TEMPO_SEGURAR = 1     -- segundos segurando pra abrir
local DISTANCIA_MAX = 15    -- distância máxima pra pegar itens
-- =========================
 
local function remote(nome)
    local r = Instance.new("RemoteEvent")
    r.Name = nome
    r.Parent = ReplicatedStorage
    return r
end
 
local abrirRemote = remote("AbrirLoot")
local pegarRemote = remote("PegarLoot")
local avisoRemote = remote("AvisoLoot")
 
local darItem = ServerStorage:WaitForChild("DarItem")
local tirarItem = ServerStorage:WaitForChild("TirarItem")
local function estaVivo(jogador)
    local char = jogador.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end
 
local function pontoNoChao(pos, char)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char}
    local r = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -30, 0), params)
    if r then
        return r.Position + Vector3.new(0, 0.75, 0)
    end
    return pos
end
 
local function criarMochila(jogador, pos, itens, ouro)
    local m = Instance.new("Part")
    m.Name = "MochilaLoot"
    m.Size = Vector3.new(2, 1.5, 1.2)
    m.Position = pos
    m.Anchored = true
    m.CanCollide = false
    m.Material = Enum.Material.Leather
    m.Color = Color3.fromRGB(120, 80, 45)
    
    local dono = Instance.new("IntValue")
    dono.Name = "DonoId"
    dono.Value = jogador.UserId
    dono.Parent = m
    
    local livre = Instance.new("BoolValue")
    livre.Name = "Livre"
    livre.Parent = m
    
    local o = Instance.new("IntValue")
    o.Name = "Ouro"
    o.Value = ouro
    o.Parent = m
    
    local pasta = Instance.new("Folder")
    pasta.Name = "Itens"
    pasta.Parent = m
    for nome, qtd in pairs(itens) do
        local v = Instance.new("IntValue")
        v.Name = nome
        v.Value = qtd
        v.Parent = pasta
    end
    
    -- nome em cima
    local gui = Instance.new("BillboardGui")
    gui.Adornee = m
    gui.Size = UDim2.new(0, 140, 0, 24)
    gui.StudsOffset = Vector3.new(0, 2, 0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 60
    gui.Parent = m
    
    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = jogador.Name
    txt.TextColor3 = Color3.new(1, 1, 1)
    txt.TextStrokeTransparency = 0.3
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 16
    txt.Parent = gui
    
    -- clicar e segurar
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = "Abrir"
    prompt.ObjectText = "Mochila"
    prompt.HoldDuration = TEMPO_SEGURAR
    prompt.MaxActivationDistance = 8
    prompt.RequiresLineOfSight = false
    prompt.Parent = m
    
    prompt.Triggered:Connect(function(quem)
        if not estaVivo(quem) then return end
        if livre.Value or quem.UserId == dono.Value then
            abrirRemote:FireClient(quem, m)
        else
            avisoRemote:FireClient(quem, "Só o dono pode pegar agora")
        end
    end)
    
    m.Parent = workspace
    
    -- depois do tempo, qualquer um pode pegar
    task.delay(TEMPO_DONO, function()
        if m.Parent then
            livre.Value = true
            txt.Text = "Loot"
            -- some sozinha depois de um tempo
            task.delay(TEMPO_SUMIR, function()
                if m.Parent then
                    m:Destroy()
                end
            end)
        end
    end)
end
 
local function aoMorrer(jogador, char)
    local inv = jogador:FindFirstChild("Inventario")
    local stats = jogador:FindFirstChild("leaderstats")
    if not inv or not stats then return end
    
    local pos = pontoNoChao(char:GetPivot().Position, char)
    local itens = {}
    local temAlgo = false
    
    for _, item in ipairs(inv:GetChildren()) do
        local perde = math.floor(item.Value * PORCENTAGEM + 0.5)
        if perde > 0 then
            itens[item.Name] = perde
            temAlgo = true
        end
    end
    
    local ouro = math.floor(stats.Ouro.Value * PORCENTAGEM)
    if ouro > 0 then temAlgo = true end
    
    if not temAlgo then return end
    
    for nome, qtd in pairs(itens) do
        tirarItem:Invoke(jogador, nome, qtd)
    end
    stats.Ouro.Value -= ouro
    
    criarMochila(jogador, pos, itens, ouro)
end
 
local function ligar(jogador)
    local function conectar(char)
        local hum = char:WaitForChild("Humanoid")
        hum.Died:Connect(function()
            aoMorrer(jogador, char)
        end)
    end
    
    jogador.CharacterAdded:Connect(conectar)
    if jogador.Character then
        task.spawn(conectar, jogador.Character)
    end
end
 
for _, p in ipairs(Players:GetPlayers()) do
    ligar(p)
end
Players.PlayerAdded:Connect(ligar)
 
-- pegar item ou ouro do loot
pegarRemote.OnServerEvent:Connect(function(jogador, mochila, nome)
    if typeof(mochila) ~= "Instance" or mochila.Name ~= "MochilaLoot" then return end
    if not mochila:IsDescendantOf(workspace) then return end
    if type(nome) ~= "string" then return end
    if not estaVivo(jogador) then return end
    
    local dono = mochila:FindFirstChild("DonoId")
    local livre = mochila:FindFirstChild("Livre")
    local pasta = mochila:FindFirstChild("Itens")
    local ouro = mochila:FindFirstChild("Ouro")
    if not (dono and livre and pasta and ouro) then return end
    
    if not livre.Value and jogador.UserId ~= dono.Value then return end
    
    local char = jogador.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or (hrp.Position - mochila.Position).Magnitude > DISTANCIA_MAX then return end
    
    if nome == "__OURO" then
        local stats = jogador:FindFirstChild("leaderstats")
        if stats and ouro.Value > 0 then
            stats.Ouro.Value += ouro.Value
            ouro.Value = 0
        end
    else
        local item = pasta:FindFirstChild(nome)
        if item and item.Value > 0 then
            -- se a mochila encher, o que não coube continua no loot
            local pegou = darItem:Invoke(jogador, nome, item.Value)
            item.Value -= pegou
            if item.Value <= 0 then
                item:Destroy()
            end
        end
    end
    
    -- loot vazio some
    if ouro.Value <= 0 and #pasta:GetChildren() == 0 then
        mochila:Destroy()
    end
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8033340041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8103335513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Armario</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("ConfigPersonagem"))

-- ===== CONFIGURAÇÕES =====
local NOME_ARMARIO = "Armario" -- nome do Model
local NOME_PARTE = "Frente"    -- Part onde aparece o botão
local TEMPO_SEGURAR = 1        -- segundos segurando pra abrir
local DISTANCIA_MAX = 15       -- distância máxima pra trocar a aparência
-- =========================

local function criarRemote(nome)
    local r = Instance.new("RemoteEvent")
    r.Name = nome
    r.Parent = ReplicatedStorage
    return r
end

local abrirRemote = criarRemote("AbrirArmario")
local trocarRemote = criarRemote("TrocarAparencia")

local frentes = {}
local ultimaTroca = {}

local function estaVivo(jogador)
    local char = jogador.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function configurarArmario(modelo)
    if not modelo:IsA("Model") or modelo.Name ~= NOME_ARMARIO then return end
    
    local frente = modelo:FindFirstChild(NOME_PARTE, true)
    if not frente or not frente:IsA("BasePart") then
        warn("Armario sem uma Part chamada " .. NOME_PARTE)
        return
    end
    if frente:FindFirstChildOfClass("ProximityPrompt") then return end
    
    table.insert(frentes, frente)
    
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = "Abrir"
    prompt.ObjectText = "Armário"
    prompt.HoldDuration = TEMPO_SEGURAR
    prompt.MaxActivationDistance = 8
    prompt.RequiresLineOfSight = false
    prompt.Parent = frente
    
    prompt.Triggered:Connect(function(jogador)
        if not estaVivo(jogador) then return end
        abrirRemote:FireClient(jogador, frente)
    end)
end

for _, obj in ipairs(workspace:GetDescendants()) do
    configurarArmario(obj)
end
workspace.DescendantAdded:Connect(configurarArmario)

local function perto(jogador)
    local char = jogador.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    for _, f in ipairs(frentes) do
        if f.Parent and (f.Position - hrp.Position).Magnitude <= DISTANCIA_MAX then
            return true
        end
    end
    return false
end

local function indiceValido(v, lista)
    return type(v) == "number" and v == math.floor(v) and v >= 1 and v <= #lista
end

trocarRemote.OnServerEvent:Connect(function(jogador, pele, cabelo, roupa)
    if not estaVivo(jogador) or not perto(jogador) then return end
    
    if not (indiceValido(pele, Config.PELES)
        and indiceValido(cabelo, Config.CABELOS)
        and indiceValido(roupa, Config.CONJUNTOS)) then
        return
    end
    
    -- evita spam
    if os.clock() - (ultimaTroca[jogador] or 0) < 2 then return end
    ultimaTroca[jogador] = os.clock()
    
    local a = jogador:FindFirstChild("Aparencia")
    local hum = jogador.Character and jogador.Character:FindFirstChildOfClass("Humanoid")
    if not a or not hum then return end
    
    local ok, erro = pcall(function()
        hum:ApplyDescription(Config.montarDescricao(pele, cabelo, roupa))
    end)
    
    if ok then
        -- só salva a escolha se aplicou sem erro
        a.Pele.Value = pele
        a.Cabelo.Value = cabelo
        a.Roupa.Value = roupa
    else
        warn("Armario: falha ao aplicar a aparência: " .. tostring(erro))
    end
end)

Players.PlayerRemoving:Connect(function(jogador)
    ultimaTroca[jogador] = nil
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8033360041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8103337513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">NoiteDia</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
 
-- Configurações
local DURACAO_DIA = 600 -- 10 minutos
local DURACAO_NOITE = 300 -- 5 minutos
 
local HORA_DIA = 6
local HORA_NOITE = 18
 
while true do
    -- DIA
    Lighting.ClockTime = HORA_DIA
    
    for i = 0, DURACAO_DIA do
        Lighting.ClockTime = 6 + (i / DURACAO_DIA) * 12
        task.wait(1)
    end
    
    -- NOITE
    for i = 0, DURACAO_NOITE do
        Lighting.ClockTime = 18 + (i / DURACAO_NOITE) * 12
        task.wait(1)
    end
end
 

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8033380041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8103339513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Personagem</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
 
-- ninguém nasce sozinho: só depois do menu
Players.CharacterAutoLoads = false
 
local Config = require(ReplicatedStorage:WaitForChild("ConfigPersonagem"))
 
local function criarRemote(nome)
    local r = Instance.new("RemoteEvent")
    r.Name = nome
    r.Parent = ReplicatedStorage
    return r
end
 
local jogarRemote = criarRemote("MenuJogar")
local abrirCriacao = criarRemote("AbrirCriacao")
local confirmarRemote = criarRemote("ConfirmarPersonagem")
 
local ocupado = {}
 
local function spawnar(jogador)
    if ocupado[jogador] or not jogador.Parent then return end
    ocupado[jogador] = true
    
    local a = jogador:FindFirstChild("Aparencia")
    local pele = a and a.Pele.Value or 1
    local cabelo = a and a.Cabelo.Value or 1
    local roupa = a and a.Roupa.Value or 1
    
    local ok, erro = pcall(function()
        local desc = Config.montarDescricao(pele, cabelo, roupa)
        jogador:LoadCharacterWithHumanoidDescription(desc)
    end)
    
    if not ok then
        warn("Personagem: falha ao montar (" .. tostring(erro) .. "). Usando avatar padrão.")
        pcall(function()
            jogador:LoadCharacter()
        end)
    end
    
    ocupado[jogador] = nil
end
 
-- usado pelo script Morte (renascer)
local spawnarFn = Instance.new("BindableFunction")
spawnarFn.Name = "Spawnar"
spawnarFn.Parent = ServerStorage
spawnarFn.OnInvoke = spawnar
 
local function valor(classe, nome, v, pai)
    local x = Instance.new(classe)
    x.Name = nome
    x.Value = v
    x.Parent = pai
end
 
local function ligar(jogador)
    local a = Instance.new("Folder")
    a.Name = "Aparencia"
    valor("IntValue", "Pele", 1, a)
    valor("IntValue", "Cabelo", 1, a)
    valor("IntValue", "Roupa", 1, a)
    valor("BoolValue", "Criado", false, a)
    a.Parent = jogador
end
 
for _, p in ipairs(Players:GetPlayers()) do
    ligar(p)
end
Players.PlayerAdded:Connect(ligar)
Players.PlayerRemoving:Connect(function(jogador)
    ocupado[jogador] = nil
end)
 
-- botão Jogar
jogarRemote.OnServerEvent:Connect(function(jogador)
    if jogador.Character or ocupado[jogador] then return end
    
    jogador:WaitForChild("DadosCarregados", 30) -- espera o save carregar
    local a = jogador:FindFirstChild("Aparencia")
    if not a or jogador.Character then return end
    
    if a.Criado.Value then
        spawnar(jogador)
    else
        abrirCriacao:FireClient(jogador)
    end
end)
 
-- confirmar a criação (só na primeira vez)
local function indiceValido(v, lista)
    return type(v) == "number" and v == math.floor(v) and v >= 1 and v <= #lista
end
 
confirmarRemote.OnServerEvent:Connect(function(jogador, pele, cabelo, roupa)
    if jogador.Character or ocupado[jogador] then return end
    
    local a = jogador:FindFirstChild("Aparencia")
    if not a or a.Criado.Value then return end
    
    if not (indiceValido(pele, Config.PELES)
        and indiceValido(cabelo, Config.CABELOS)
        and indiceValido(roupa, Config.CONJUNTOS)) then
        return
    end
    
    a.Pele.Value = pele
    a.Cabelo.Value = cabelo
    a.Roupa.Value = roupa
    a.Criado.Value = true
    
    spawnar(jogador)
end)

]]></ProtectedString>
