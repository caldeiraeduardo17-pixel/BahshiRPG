<Item class="Script" referent="RBX66C1625455D04AC580D8103327513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Equipamento</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ===== CONFIGURAÇÕES =====
local NUM_SLOTS = 4
local EQUIPAR_SLOT1_AO_NASCER = true
local ITENS_INICIAIS = {
{"Espada Inicial", 1}, -- {nome do item, slot onde já começa}
-- {"Tocha", 2},
}
-- =========================

local modelos = ServerStorage:WaitForChild("Equipaveis", 10)
if not modelos then
    warn("Equipamento: crie a pasta 'Equipaveis' no ServerStorage com as Tools")
    return
end

-- lista de itens equipáveis pro cliente
local info = Instance.new("Folder")
info.Name = "EquipaveisInfo"
for _, t in ipairs(modelos:GetChildren()) do
    if t:IsA("Tool") then
        local v = Instance.new("StringValue")
        v.Name = t.Name
        v.Value = t:FindFirstChild("Empilhavel") and "empilha" or ""
        v.Parent = info
        print("Equipamento: equipável registrado -> '" .. t.Name .. "'")
    else
        warn("Equipamento: '" .. t.Name .. "' está em Equipaveis mas é " .. t.ClassName .. ", não uma Tool")
    end
end
info.Parent = ReplicatedStorage

local function criarRemote(nome)
    local r = Instance.new("RemoteEvent")
    r.Name = nome
    r.Parent = ReplicatedStorage
    return r
end

local usarRemote = criarRemote("UsarSlot")
local equiparRemote = criarRemote("EquiparSlot")

local ferramentas = {} -- [jogador] = {[slot] = Tool}

local function nomeNoSlot(jogador, i)
    local pasta = jogador:FindFirstChild("Slots")
    local v = pasta and pasta:FindFirstChild(tostring(i))
    return v and v.Value or ""
end

local function temNoInventario(jogador, nome)
    local inv = jogador:FindFirstChild("Inventario")
    local item = inv and inv:FindFirstChild(nome)
    return item ~= nil and item.Value > 0
end

local function atualizarFerramenta(jogador, i)
    local mapa = ferramentas[jogador]
    if not mapa then return end
    
    local nome = nomeNoSlot(jogador, i)
    local atual = mapa[i]
    
    if atual and atual.Parent and atual.Name == nome then return end
    if atual then
        atual:Destroy()
        mapa[i] = nil
    end
    if nome == "" then return end
    
    local modelo = modelos:FindFirstChild(nome)
    if not modelo then
        warn("Equipamento: não existe a Tool '" .. nome .. "' em ServerStorage > Equipaveis")
        return
    end
    
    local mochila = jogador:FindFirstChildOfClass("Backpack")
    if not mochila then return end
    
    local t = modelo:Clone()
    t.CanBeDropped = false
    t.Parent = mochila
    mapa[i] = t
end

local function sincronizarTudo(jogador)
    for i = 1, NUM_SLOTS do
        atualizarFerramenta(jogador, i)
    end
end

local function segurarSlot1(jogador)
    if not EQUIPAR_SLOT1_AO_NASCER then return end
    local char = jogador.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local mapa = ferramentas[jogador]
    local t = mapa and mapa[1]
    if hum and hum.Health > 0 and t and t.Parent then
        hum:EquipTool(t)
    end
end

local function aoNascer(jogador, char)
    if not jogador or not char then return end
    
    local hum = char:WaitForChild("Humanoid", 10)
    local mochila = jogador:WaitForChild("Backpack", 10)
    if not hum or not mochila then return end
    
    task.wait(0.3)
    sincronizarTudo(jogador)
    segurarSlot1(jogador)
    
    task.wait(1.5)
    sincronizarTudo(jogador)
end

local function ligar(jogador)
    ferramentas[jogador] = {}
    
    local pasta = Instance.new("Folder")
    pasta.Name = "Slots"
    for i = 1, NUM_SLOTS do
        local v = Instance.new("StringValue")
        v.Name = tostring(i)
        v.Changed:Connect(function()
            atualizarFerramenta(jogador, i)
        end)
        v.Parent = pasta
    end
    pasta.Parent = jogador
    
    -- se o item acabar do inventário, tira do slot
    task.spawn(function()
        local inv = jogador:WaitForChild("Inventario", 30)
        if not inv then return end
        inv.ChildRemoved:Connect(function(item)
            if inv:FindFirstChild(item.Name) then return end
            for i = 1, NUM_SLOTS do
                if nomeNoSlot(jogador, i) == item.Name then
                    pasta[tostring(i)].Value = ""
                end
            end
        end)
    end)
    
    jogador.CharacterAdded:Connect(function(char)
        aoNascer(jogador, char)
    end)
    if jogador.Character then
        task.spawn(aoNascer, jogador, jogador.Character)
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    ligar(p)
end
Players.PlayerAdded:Connect(ligar)
Players.PlayerRemoving:Connect(function(jogador)
    ferramentas[jogador] = nil
end)

-- segurar / guardar o item do slot
usarRemote.OnServerEvent:Connect(function(jogador, i)
    if type(i) ~= "number" then return end
    i = math.floor(i)
    if i < 1 or i > NUM_SLOTS then return end
    
    local char = jogador.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    
    local mapa = ferramentas[jogador]
    local tool = mapa and mapa[i]
    if not tool or not tool.Parent then return end
    
    if tool.Parent == char then
        hum:UnequipTools()
    else
        hum:EquipTool(tool)
    end
end)

-- colocar / trocar / tirar um item de um slot
equiparRemote.OnServerEvent:Connect(function(jogador, i, nome)
    if type(i) ~= "number" or type(nome) ~= "string" then return end
    i = math.floor(i)
    if i < 1 or i > NUM_SLOTS then return end
    
    local pasta = jogador:FindFirstChild("Slots")
    if not pasta then return end
    
    -- nome vazio: só tira o item daquele slot
    if nome == "" then
        pasta[tostring(i)].Value = ""
        return
    end
    
    if not modelos:FindFirstChild(nome) then return end
    if not temNoInventario(jogador, nome) then return end
    
    local noDestino = nomeNoSlot(jogador, i)
    if noDestino == nome then return end -- já está nesse slot
        
        -- o item já está em outro slot? então os dois trocam de lugar
        for j = 1, NUM_SLOTS do
            if j ~= i and nomeNoSlot(jogador, j) == nome then
                pasta[tostring(j)].Value = noDestino -- fica vazio se o destino estava vazio
                break
            end
        end
        
        pasta[tostring(i)].Value = nome
    end)
    
    -- usado pelo script Salvar
    local definirFn = Instance.new("BindableFunction")
    definirFn.Name = "DefinirSlots"
    definirFn.Parent = ServerStorage
    definirFn.OnInvoke = function(jogador, lista)
        local pasta = jogador:FindFirstChild("Slots")
        if not pasta then return end
        
        for i = 1, NUM_SLOTS do
            local nome = lista and lista[tostring(i)] or ""
            if nome ~= "" and (not modelos:FindFirstChild(nome) or not temNoInventario(jogador, nome)) then
                nome = ""
            end
            pasta[tostring(i)].Value = nome
        end
        
        sincronizarTudo(jogador)
        segurarSlot1(jogador)
    end
    
    -- itens que todo jogador novo recebe
    local iniciaisFn = Instance.new("BindableFunction")
    iniciaisFn.Name = "DarIniciais"
    iniciaisFn.Parent = ServerStorage
    iniciaisFn.OnInvoke = function(jogador)
        local inv = jogador:FindFirstChild("Inventario")
        local pasta = jogador:FindFirstChild("Slots")
        if not inv or not pasta then
            warn("Equipamento: jogador sem Inventario ou Slots")
            return
        end
        
        for _, par in ipairs(ITENS_INICIAIS) do
            local nome, slot = par[1], par[2]
            if not inv:FindFirstChild(nome) then
                local item = Instance.new("IntValue")
                item.Name = nome
                item.Value = 1
                item.Parent = inv
            end
            if slot then
                pasta[tostring(slot)].Value = nome
            end
        end
        
        ServerStorage:WaitForChild("Recalcular"):Invoke(jogador)
        sincronizarTudo(jogador)
        segurarSlot1(jogador)
        print("Equipamento: itens iniciais entregues a " .. jogador.Name)
    end

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8033280041fa</UniqueId>
