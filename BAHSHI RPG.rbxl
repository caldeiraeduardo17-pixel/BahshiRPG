<Item class="ModuleScript" referent="RBX6A5AB5395EC24443840DD03453C34F7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">ConfigPersonagem</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[local Config = {}

Config.NOME_JOGO = "Bahshi RPG"
Config.ROSTO = 0 -- ID do rosto (0 = padrão do Roblox)

-- Tons de pele (pode mudar, adicionar ou tirar)
Config.PELES = {
{nome = "Clara",        cor = Color3.fromRGB(255, 224, 189)},
{nome = "Bege",         cor = Color3.fromRGB(241, 194, 125)},
{nome = "Morena",       cor = Color3.fromRGB(224, 172, 105)},
{nome = "Dourada",      cor = Color3.fromRGB(198, 134, 66)},
{nome = "Marrom",       cor = Color3.fromRGB(141, 85, 36)},
{nome = "Escura",       cor = Color3.fromRGB(110, 67, 33)},
{nome = "Muito escura", cor = Color3.fromRGB(80, 50, 30)},
}

-- Cabelos: ID do acessório entre aspas. "" = sem cabelo. Vários IDs: "123,456"
Config.CABELOS = {
{nome = "Careca",   id = ""},
{nome = "Cabelo 1", id = "12911991289"}, -- cole o ID aqui
{nome = "Cabelo 2", id = "13260631087"},
{nome = "Cabelo 3", id = "77462206976651"},
{nome = "Cabelo 4", id = "105982567636329"},
{nome = "Cabelo 5", id = "130464333800273"},
{nome = "Cabelo 6", id = "113101387464622"},
}

-- Conjuntos de roupa: ID da camisa e da calça. O PRIMEIRO é o padrão.
Config.CONJUNTOS = {
{nome = "Padrão",     camisa = 71509573303941, calca = 87997703785715},
{nome = "Conjunto 2", camisa = 12113550320, calca = 125799319586495},
{nome = "Conjunto 3", camisa = 111485238504670, calca = 8979783775},
{nome = "Conjunto 4", camisa = 106699927496272, calca = 8979783775},
{nome = "Conjunto 5", camisa = 9134737273, calca = 8979783775},
{nome = "Coniunto 6", camisa = 595225271, calca = 125799319586495},
{nome = "Conjunto 7", camisa = 103123088582337, calca = 11933666002},
{nome = "Conjunto 8", camisa = 79663249192951, calca = 95308227566546},
}

function Config.montarDescricao(pele, cabelo, roupa)
    local p = Config.PELES[pele] or Config.PELES[1]
    local c = Config.CABELOS[cabelo] or Config.CABELOS[1]
    local r = Config.CONJUNTOS[roupa] or Config.CONJUNTOS[1]
    
    local d = Instance.new("HumanoidDescription")
    d.HeadColor = p.cor
    d.TorsoColor = p.cor
    d.LeftArmColor = p.cor
    d.RightArmColor = p.cor
    d.LeftLegColor = p.cor
    d.RightLegColor = p.cor
    
    d.Shirt = r.camisa
    d.Pants = r.calca
    d.Face = Config.ROSTO
    
    local idCabelo = tostring(c.id or "")
    if idCabelo ~= "" and idCabelo ~= "0" then
        d.HairAccessory = idCabelo
    end
    
    return d
end

return Config


]]></ProtectedString>
