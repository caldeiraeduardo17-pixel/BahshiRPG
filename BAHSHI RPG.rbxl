<Item class="Script" referent="RBX66C1625455D04AC580D8103313513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Habilidades</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
 
local avisoEvento = Instance.new("RemoteEvent")
avisoEvento.Name = "HabilidadeSubiu"
avisoEvento.Parent = ReplicatedStorage

local LISTA = {"Espada", "Arco", "Corrida", "Vitalidade", "Defesa"}

local evento = Instance.new("BindableEvent")
evento.Name = "TreinarHabilidade"
evento.Parent = ServerStorage

local BASE_XP = 10
local EXPOENTE = 1.15 -- 1 = igual a antes / 1.15 = um pouco mais difícil / 1.3 = bem mais difícil

local function xpPara(nivel)
    return math.floor(BASE_XP * nivel ^ EXPOENTE)
end

local function nivelDe(player, nome)
    local pasta = player:FindFirstChild("Habilidades")
    local h = pasta and pasta:FindFirstChild(nome)
    return h and h.Nivel.Value or 0
end

local function aplicar(player)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    local vel = 8 + (nivelDe(player, "Corrida") - 1) * 0.3
    local cheia = player:FindFirstChild("MochilaCheia")
    if cheia and cheia.Value then
        vel = vel * 0.6 -- mochila cheia: 40% mais lento
    end
    hum.WalkSpeed = vel
    
    local vidaMax = 50 + (nivelDe(player, "Vitalidade") - 1) * 5
    if hum.MaxHealth ~= vidaMax then
        local sobe = vidaMax - hum.MaxHealth
        hum.MaxHealth = vidaMax
        if sobe > 0 then
            hum.Health += sobe
        end
    end
end


local function treinar(player, nome, qtd)
    local pasta = player:FindFirstChild("Habilidades")
    local h = pasta and pasta:FindFirstChild(nome)
    if not h then return end
    h.XP.Value += qtd or 1
    while h.XP.Value >= xpPara(h.Nivel.Value) do
        h.XP.Value -= xpPara(h.Nivel.Value)
        h.Nivel.Value += 1
        h.Precisa.Value = xpPara(h.Nivel.Value)
        aplicar(player)
        avisoEvento:FireClient(player, nome, h.Nivel.Value)
    end
end

evento.Event:Connect(treinar)
local definirFn = Instance.new("BindableFunction")
definirFn.Name = "DefinirHabilidade"
definirFn.Parent = ServerStorage
definirFn.OnInvoke = function(player, nome, nivel, xp)
    local pasta = player:FindFirstChild("Habilidades")
    local h = pasta and pasta:FindFirstChild(nome)
    if not h then return end
    
    h.Nivel.Value = nivel
    h.XP.Value = xp
    local meta = h:FindFirstChild("Precisa")
    if meta then
        meta.Value = xpPara(nivel)
    end
    aplicar(player)
end

Players.PlayerAdded:Connect(function(player)
    local pasta = Instance.new("Folder")
    pasta.Name = "Habilidades"
    pasta.Parent = player
    
    for _, nome in ipairs(LISTA) do
        local f = Instance.new("Folder")
        f.Name = nome
        local n = Instance.new("IntValue")
        n.Name = "Nivel"
        n.Value = 1
        n.Parent = f
        local x = Instance.new("IntValue")
        x.Name = "XP"
        x.Parent = f
        local p = Instance.new("IntValue")
        p.Name = "Precisa"
        p.Value = xpPara(1)
        p.Parent = f
        f.Parent = pasta
        
    end
    
    player.CharacterAdded:Connect(function(char)
        local hum = char:WaitForChild("Humanoid")
        local regen = char:FindFirstChild("Health")
        if regen then regen:Destroy() end
        aplicar(player)
        hum.Health = hum.MaxHealth
        
        local ultima = hum.Health
        hum.HealthChanged:Connect(function(nova)
            if nova < ultima then
                treinar(player, "Defesa", 1)
                treinar(player, "Vitalidade", 1)
            end
            ultima = nova
        end)
        
        -- treino de corrida
        task.spawn(function()
            while hum.Parent and hum.Health > 0 do
                if hum.MoveDirection.Magnitude > 0
                    and hum.FloorMaterial ~= Enum.Material.Air then
                    local qtd = 1
                    local c = player:FindFirstChild("MochilaCheia")
                    if c and c.Value then qtd = 3 end -- mochila cheia treina 3x
                        treinar(player, "Corrida", qtd)
                    end
                    task.wait(1)
                end
            end)
        end)
    end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8033140041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8103315513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Efeitos</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")

local TICK = 0.5 -- de quanto em quanto tempo a cura é aplicada

local tirarItem = ServerStorage:WaitForChild("TirarItem")

local curas = {} -- [jogador] = {char, pct, fim, ultimo}

-- tem cura ativa?
local ativaFn = Instance.new("BindableFunction")
ativaFn.Name = "CuraAtiva"
ativaFn.Parent = ServerStorage
ativaFn.OnInvoke = function(jogador)
    return curas[jogador] ~= nil
end

-- gasta 1 item e começa a curar. Devolve o texto do erro, ou nada se deu certo
local usarFn = Instance.new("BindableFunction")
usarFn.Name = "UsarCura"
usarFn.Parent = ServerStorage
usarFn.OnInvoke = function(jogador, item, pct, duracao)
    if curas[jogador] then
        return "Você já está se curando"
    end
    
    local char = jogador.Character
    if not char then
        return "Sem personagem"
    end
    
    if tirarItem:Invoke(jogador, item, 1) < 1 then
        return "Você não tem " .. item
    end
    
    local agora = os.clock()
    curas[jogador] = {
    char = char,
    pct = pct,
    fim = agora + duracao,
    ultimo = agora,
    }
    return nil
end

-- aplica a cura (% da vida máxima por segundo)
task.spawn(function()
    while true do
        task.wait(TICK)
        local agora = os.clock()
        
        for jogador, c in pairs(curas) do
            local char = jogador.Character
            local hum = char and char == c.char and char:FindFirstChildOfClass("Humanoid")
            
            if not jogador.Parent or not hum or hum.Health <= 0 then
                curas[jogador] = nil -- morreu ou saiu
            else
                local ate = math.min(agora, c.fim)
                local dt = ate - c.ultimo
                if dt > 0 then
                    hum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * c.pct * dt)
                    c.ultimo = ate
                end
                if agora >= c.fim then
                    curas[jogador] = nil
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(jogador)
    curas[jogador] = nil
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8033160041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8103317513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">CamaServer</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
 
-- ===== CONFIGURAÇÕES =====
local NOME_CAMA = "Cama"         -- nome do Model
local NOME_COLCHAO = "Colchao"   -- nome da Part onde deita
local CURA_POR_SEGUNDO = 0.02    -- 2% da vida máxima por segundo
local TEMPO_SEGURAR = 1          -- segundos segurando pra deitar
local GIRO = 90                   -- 0, 90, 180 ou 270: direção da cabeça
local ALTURA = 0.6               -- altura do corpo acima do colchão
-- =========================
 
local estadoRemote = Instance.new("RemoteEvent")
estadoRemote.Name = "EstadoCama"
estadoRemote.Parent = ReplicatedStorage
 
local levantarRemote = Instance.new("RemoteEvent")
levantarRemote.Name = "LevantarCama"
levantarRemote.Parent = ReplicatedStorage
 
local deitados = {}
 
local function levantar(jogador, reposicionar)
    local d = deitados[jogador]
    if not d then return end
    deitados[jogador] = nil
    
    if d.hrp and d.hrp.Parent then
        d.hrp.Anchored = false
        if reposicionar then
            -- volta pro lugar onde você estava antes de deitar
            d.hrp.CFrame = d.antes + Vector3.new(0, 0.5, 0)
        end
    end
    if d.hum and d.hum.Parent then
        d.hum.PlatformStand = false
    end
    d.prompt.Enabled = true
    
    if jogador.Parent then
        estadoRemote:FireClient(jogador, false)
    end
end
 
local function deitar(jogador, colchao, prompt)
    if deitados[jogador] then return end
    
    local char = jogador.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return end
    
    deitados[jogador] = {
    hrp = hrp,
    hum = hum,
    colchao = colchao,
    prompt = prompt,
    antes = hrp.CFrame,
    ultimaVida = hum.Health,
    }
    prompt.Enabled = false -- cama ocupada
    
    hum.PlatformStand = true
    hrp.Anchored = true
    hrp.CFrame = colchao.CFrame
    * CFrame.new(0, colchao.Size.Y / 2 + ALTURA, 0)
    * CFrame.Angles(0, math.rad(GIRO), 0)
    * CFrame.Angles(math.rad(90), 0, 0)
    
    estadoRemote:FireClient(jogador, true)
end
 
local function configurarCama(modelo)
    if not modelo:IsA("Model") or modelo.Name ~= NOME_CAMA then return end
    
    local colchao = modelo:FindFirstChild(NOME_COLCHAO, true)
    if not colchao or not colchao:IsA("BasePart") then
        warn("Cama sem uma Part chamada " .. NOME_COLCHAO)
        return
    end
    if colchao:FindFirstChildOfClass("ProximityPrompt") then return end
    
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = "Deitar"
    prompt.ObjectText = "Cama"
    prompt.HoldDuration = TEMPO_SEGURAR
    prompt.MaxActivationDistance = 8
    prompt.RequiresLineOfSight = false
    prompt.Parent = colchao
    
    prompt.Triggered:Connect(function(jogador)
        deitar(jogador, colchao, prompt)
    end)
end
 
for _, obj in ipairs(workspace:GetDescendants()) do
    configurarCama(obj)
end
workspace.DescendantAdded:Connect(configurarCama)
 
levantarRemote.OnServerEvent:Connect(function(jogador)
    levantar(jogador, true)
end)
 
Players.PlayerRemoving:Connect(function(jogador)
    levantar(jogador, false)
end)
 
-- cura em porcentagem da vida máxima
task.spawn(function()
    while true do
        task.wait(1)
        for jogador, d in pairs(deitados) do
            local hum = d.hum
            if not hum or not hum.Parent or hum.Health <= 0 or not jogador.Parent then
                levantar(jogador, false) -- morreu ou saiu
            elseif hum.Health < d.ultimaVida - 0.01 then
                levantar(jogador, true) -- tomou dano: levanta
            else
                local nova = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * CURA_POR_SEGUNDO)
                hum.Health = nova
                d.ultimaVida = nova
                if nova >= hum.MaxHealth then
                    levantar(jogador, true) -- vida cheia: levanta
                end
            end
        end
    end
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8033180041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8103319513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Morte</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
 
local renascer = RS:FindFirstChild("Renascer") or Instance.new("RemoteEvent")
renascer.Name = "Renascer"
renascer.Parent = RS
 
renascer.OnServerEvent:Connect(function(jogador)
    -- só renasce quem está morto
    local char = jogador.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then return end
    
    print("Morte: renascendo", jogador.Name)
    ServerStorage:WaitForChild("Spawnar"):Invoke(jogador)
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8033200041fa</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8103321513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Salvar</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

-- ===== CONFIGURAÇÕES =====
local NOME_DADOS = "DadosRPG_v0.4" -- mude o nome pra começar o save do zero
local AUTOSAVE = 1              -- segundos entre salvamentos automáticos
local SALVAR_POSICAO = true      -- volta pro mesmo lugar ao entrar
-- =========================

local okStore, store = pcall(function()
    return DataStoreService:GetDataStore(NOME_DADOS)
end)
if not okStore then
    store = nil
    warn("Salvar: DataStore indisponível aqui (teste no Lite). Jogando sem salvar.")
end

local carregado = {}
local salvando = {}

local function chave(jogador)
    return "Jogador_" .. jogador.UserId
end

-- ===== COLETAR =====
local function coletar(jogador)
    local stats = jogador:FindFirstChild("leaderstats")
    local hab = jogador:FindFirstChild("Habilidades")
    local inv = jogador:FindFirstChild("Inventario")
    local mochila = jogador:FindFirstChild("Mochila")
    if not (stats and hab and inv and mochila) then return nil end
    
    local dados = {
    iniciou = true,
    ouro = stats.Ouro.Value,
    nivel = stats.Nivel.Value,
    xp = stats.XP.Value,
    mochila = mochila.Nivel.Value,
    habilidades = {},
    itens = {},
    slots = {},
    }
    
    for _, h in ipairs(hab:GetChildren()) do
        if h:FindFirstChild("Nivel") and h:FindFirstChild("XP") then
            dados.habilidades[h.Name] = {nivel = h.Nivel.Value, xp = h.XP.Value}
        end
    end
    
    for _, item in ipairs(inv:GetChildren()) do
        dados.itens[item.Name] = item.Value
    end
    
    local sl = jogador:FindFirstChild("Slots")
    if sl then
        for _, v in ipairs(sl:GetChildren()) do
            dados.slots[v.Name] = v.Value
        end
    end
    local ap = jogador:FindFirstChild("Aparencia")
    if ap then
        dados.aparencia = {
        pele = ap.Pele.Value,
        cabelo = ap.Cabelo.Value,
        roupa = ap.Roupa.Value,
        criado = ap.Criado.Value,
        }
    end
    -- vida e posição só se estiver vivo
    local char = jogador.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hum and hrp and hum.Health > 0 then
        dados.vida = hum.Health
        if SALVAR_POSICAO then
            local p = hrp.Position
            dados.pos = {p.X, p.Y, p.Z}
        end
    end
    
    return dados
end

-- ===== SALVAR =====
local function salvar(jogador, final)
    if not store or not carregado[jogador] then return end
    
    if final then
        while salvando[jogador] do
            task.wait(0.1)
        end
    elseif salvando[jogador] then
        return
    end
    
    local dados = coletar(jogador)
    if not dados then return end
    
    salvando[jogador] = true
    local ok, erro = false, nil
    for _ = 1, 3 do
        ok, erro = pcall(function()
            store:UpdateAsync(chave(jogador), function()
                return dados
            end)
        end)
        if ok then break end
        task.wait(2)
    end
    salvando[jogador] = nil
    
    if not ok then
        warn("Falha ao salvar " .. jogador.Name .. ": " .. tostring(erro))
    end
end

-- ===== CARREGAR =====
local function buscar(jogador)
    local erro
    for _ = 1, 3 do
        local ok, resultado = pcall(function()
            return store:GetAsync(chave(jogador))
        end)
        if ok then
            return resultado, nil
        end
        erro = resultado
        task.wait(2)
    end
    return nil, erro
end

local function aplicarDados(jogador, dados)
    local stats = jogador.leaderstats
    local mochila = jogador.Mochila
    local inv = jogador.Inventario
    
    -- nível ANTES do XP
    stats.Nivel.Value = dados.nivel or 1
    stats.XP.Value = dados.xp or 0
    stats.Ouro.Value = dados.ouro or 0
    
    mochila.Nivel.Value = dados.mochila or 1
    
    for nome, qtd in pairs(dados.itens or {}) do
        local item = inv:FindFirstChild(nome)
        if not item then
            item = Instance.new("IntValue")
            item.Name = nome
            item.Parent = inv
        end
        item.Value = qtd
    end
    ServerStorage:WaitForChild("Recalcular"):Invoke(jogador)
    
    local definir = ServerStorage:WaitForChild("DefinirHabilidade")
    for nome, h in pairs(dados.habilidades or {}) do
        definir:Invoke(jogador, nome, h.nivel or 1, h.xp or 0)
    end
    
    ServerStorage:WaitForChild("DefinirSlots"):Invoke(jogador, dados.slots)
    
    local ap = jogador:FindFirstChild("Aparencia")
    if ap and dados.aparencia then
        ap.Pele.Value = dados.aparencia.pele or 1
        ap.Cabelo.Value = dados.aparencia.cabelo or 1
        ap.Roupa.Value = dados.aparencia.roupa or 1
        ap.Criado.Value = dados.aparencia.criado == true
    end
    
    -- vida e posição no personagem atual
    task.spawn(function()
        local char = jogador.Character or jogador.CharacterAdded:Wait()
        local hum = char:WaitForChild("Humanoid")
        char:WaitForChild("HumanoidRootPart")
        task.wait(0.5)
        
        if dados.vida and hum.Health > 0 then
            hum.Health = math.clamp(dados.vida, 1, hum.MaxHealth)
        end
        if SALVAR_POSICAO and dados.pos and dados.pos[2] > -50 then
            char:PivotTo(CFrame.new(dados.pos[1], dados.pos[2] + 3, dados.pos[3]))
        end
    end)
end

local function marcarPronto(jogador)
    local f = Instance.new("BoolValue")
    f.Name = "DadosCarregados"
    f.Value = true
    f.Parent = jogador
end

local function aoEntrar(jogador)
    local stats = jogador:WaitForChild("leaderstats", 30)
    local hab = jogador:WaitForChild("Habilidades", 30)
    local inv = jogador:WaitForChild("Inventario", 30)
    local mochila = jogador:WaitForChild("Mochila", 30)
    local slots = jogador:WaitForChild("Slots", 30)
    local aparencia = jogador:WaitForChild("Aparencia", 30)
    if not (stats and hab and inv and mochila and slots and aparencia) then
        warn("Salvar: faltam valores do jogador " .. jogador.Name)
        marcarPronto(jogador)
        return
    end
    stats:WaitForChild("Ouro")
    stats:WaitForChild("Nivel")
    stats:WaitForChild("XP")
    mochila:WaitForChild("Nivel")
    
    -- sem DataStore (teste no Lite): joga sem salvar, mas recebe os itens iniciais
    if not store then
        print("Salvar: sem DataStore, entregando itens iniciais")
        ServerStorage:WaitForChild("DarIniciais"):Invoke(jogador)
        marcarPronto(jogador)
        return
    end
    
    local dados, erro = buscar(jogador)
    
    if erro then
        warn("Falha ao carregar " .. jogador.Name .. ": " .. tostring(erro))
        if RunService:IsStudio() then
            ServerStorage:WaitForChild("DarIniciais"):Invoke(jogador)
            marcarPronto(jogador)
            return
        end
        jogador:Kick("Não foi possível carregar seus dados. Entre de novo.")
        return
    end
    
    if dados then
        aplicarDados(jogador, dados)
    end
    if not (dados and dados.iniciou) then
        ServerStorage:WaitForChild("DarIniciais"):Invoke(jogador)
    end
    
    carregado[jogador] = true
    marcarPronto(jogador)
end

for _, p in ipairs(Players:GetPlayers()) do
    task.spawn(aoEntrar, p)
end
Players.PlayerAdded:Connect(aoEntrar)

Players.PlayerRemoving:Connect(function(jogador)
    salvar(jogador, true)
    carregado[jogador] = nil
end)

-- salvamento automático
task.spawn(function()
    while true do
        task.wait(AUTOSAVE)
        for _, p in ipairs(Players:GetPlayers()) do
            task.spawn(salvar, p, false)
        end
    end
end)

-- quando o servidor fecha
game:BindToClose(function()
    local restantes = 0
    for _, p in ipairs(Players:GetPlayers()) do
        restantes += 1
        task.spawn(function()
            salvar(p, true)
            restantes -= 1
        end)
    end
    local inicio = os.clock()
    while restantes > 0 and os.clock() - inicio < 25 do
        task.wait(0.2)
    end
end)

]]></ProtectedString>
