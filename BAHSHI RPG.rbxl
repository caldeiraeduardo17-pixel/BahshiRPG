<Item class="Script" referent="RBX66C1625455D04AC580D8102997513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
 
local inimigo = script.Parent
local humanoid = inimigo:WaitForChild("Humanoid")
local raiz = inimigo:WaitForChild("HumanoidRootPart")
-- ===== RENASCIMENTO =====
local TEMPO_RENASCER = 30 -- segundos até voltar
local modeloOriginal = inimigo:Clone() -- cópia limpa, tirada antes de mexer em qualquer coisa
local paiOriginal = inimigo.Parent
local posOriginal = inimigo:GetPivot()
-- ========================

 
-- Configurações (mude aqui pra cada inimigo)
local XP = 30
local OURO = 10
local DANO = 8
local VIDA = 50
local VELOCIDADE = 14
local ALCANCE_VISAO = 40
local ALCANCE_ATAQUE = 5
local COOLDOWN = 1.5
 
humanoid.MaxHealth = VIDA
humanoid.Health = VIDA
humanoid.WalkSpeed = VELOCIDADE
-- ===== BARRA DE VIDA DO INIMIGO =====
humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None -- esconde a barra padrão
 
local NOME_INIMIGO = inimigo.Name
local NIVEL_INIMIGO = 1 -- mude pra cada inimigo
 
local gui = Instance.new("BillboardGui")
gui.Name = "BarraVida"
gui.Adornee = raiz
gui.Size = UDim2.new(0, 100, 0, 28)
gui.StudsOffset = Vector3.new(0, 3.5, 0)
gui.AlwaysOnTop = true
gui.MaxDistance = 60
gui.Parent = raiz
 
local titulo = Instance.new("TextLabel")
titulo.Size = UDim2.new(1, 0, 0, 14)
titulo.BackgroundTransparency = 1
titulo.Text = NOME_INIMIGO .. "  Nv " .. NIVEL_INIMIGO
titulo.TextColor3 = Color3.new(1, 1, 1)
titulo.TextStrokeTransparency = 0.4
titulo.Font = Enum.Font.GothamBold
titulo.TextSize = 12
titulo.Parent = gui
 
local fundoVida = Instance.new("Frame")
fundoVida.Position = UDim2.new(0, 0, 0, 16)
fundoVida.Size = UDim2.new(1, 0, 0, 8)
fundoVida.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
fundoVida.BorderSizePixel = 0
fundoVida.Parent = gui
 
local barraVida = Instance.new("Frame")
barraVida.Size = UDim2.new(1, 0, 1, 0)
barraVida.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
barraVida.BorderSizePixel = 0
barraVida.Parent = fundoVida
 
local function atualizarBarra()
    local pct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
    barraVida.Size = UDim2.new(pct, 0, 1, 0)
end
 
humanoid.HealthChanged:Connect(atualizarBarra)
humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(atualizarBarra)
atualizarBarra()
-- ===== FIM DA BARRA =====
humanoid.BreakJointsOnDeath = false
 
local ultimoAtaque = 0
local ServerStorage = game:GetService("ServerStorage")
local evento = ServerStorage:WaitForChild("TreinarHabilidade")
local vidaAntes = humanoid.Health
local aplicandoBonus = false
 
local function tipoDaArma(tool)
    local v = tool:FindFirstChild("Tipo")
    if v and v:IsA("StringValue") then return v.Value end
    local n = string.lower(tool.Name)
    if n:find("bow") or n:find("arco") then return "Arco" end
    return "Espada"
end
 
 
local function jogadorMaisPerto()
    local melhor, melhorDist = nil, ALCANCE_VISAO
    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then
            local d = (hrp.Position - raiz.Position).Magnitude
            if d < melhorDist then
                melhor, melhorDist = p, d
            end
        end
    end
    return melhor, melhorDist
end
 
task.spawn(function()
    while humanoid.Health > 0 do
        local alvo, dist = jogadorMaisPerto()
        if alvo then
            humanoid:MoveTo(alvo.Character.HumanoidRootPart.Position)
            if dist <= ALCANCE_ATAQUE and tick() - ultimoAtaque >= COOLDOWN then
                ultimoAtaque = tick()
                local h = alvo:FindFirstChild("Habilidades")
                local defesa = h and h.Defesa.Nivel.Value or 0
                alvo.Character.Humanoid:TakeDamage(DANO * math.max(0.3, 1 - defesa * 0.01))
            end
        end
        task.wait(0.2)
    end
end)
 
local function ragdoll()
    gui.Enabled = false
    humanoid.PlatformStand = true
    raiz.CanCollide = false
    
    for _, m in ipairs(inimigo:GetDescendants()) do
        if m:IsA("Motor6D") and m.Part0 and m.Part1 then
            local a0 = Instance.new("Attachment")
            a0.CFrame = m.C0
            a0.Parent = m.Part0
            
            local a1 = Instance.new("Attachment")
            a1.CFrame = m.C1
            a1.Parent = m.Part1
            
            local junta = Instance.new("BallSocketConstraint")
            junta.Attachment0 = a0
            junta.Attachment1 = a1
            junta.TwistLimitsEnabled = true
            junta.Parent = m.Part0
            
            m.Part1.CanCollide = true
            m:Destroy()
        end
    end
    
    raiz.AssemblyLinearVelocity = Vector3.new(0, 15, 0)
end
 
humanoid.Died:Connect(function()
    ragdoll()
    
    local alvo = jogadorMaisPerto()
    if alvo then
        local darItem = ServerStorage:FindFirstChild("DarItem")
        if darItem then
            darItem:Invoke(alvo, "Pele de Lobo", 1)
        end
        local stats = alvo:FindFirstChild("leaderstats")
        if stats then
            stats.XP.Value += XP
            stats.Ouro.Value += OURO
        end
    end
    
    -- o corpo fica caído por 3 segundos
    task.wait(3)
    
    -- depois some (invisível), mas ainda existe pra o script continuar rodando
    for _, d in ipairs(inimigo:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = true
            d.CanCollide = false
            d.Transparency = 1
        elseif d:IsA("Decal") or d:IsA("Texture") then
            d.Transparency = 1
        end
    end
    
    -- espera o tempo de renascer
    task.wait(TEMPO_RENASCER)
    
    -- cria o lobo novo no lugar original
    local novo = modeloOriginal:Clone()
    novo.Parent = paiOriginal
    novo:PivotTo(posOriginal)
    
    inimigo:Destroy()
end)
 

]]></ProtectedString>
