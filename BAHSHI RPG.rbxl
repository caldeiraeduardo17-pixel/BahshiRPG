<ProtectedString name="Source"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
 
local tool = script.Parent
local remote = tool:WaitForChild("Usar")
 
-- ===== CONFIGURAÇÕES =====
local NOME_ITEM = "Bandagem"       -- nome do item no inventário
local TEMPO_USO = 2                -- segundos pra aplicar a bandagem
local CURA_POR_SEGUNDO = 0.05      -- 5% da vida máxima por segundo
local DURACAO = 10                 -- segundos de cura
local CANCELAR_SE_DANO = true      -- tomar dano cancela o uso
local CANCELAR_SE_MOVER = false    -- true = tem que ficar parado
-- =========================
 
local usando = false
 
remote.OnServerEvent:Connect(function(jogador)
    if usando then return end
    
    local char = jogador.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 or tool.Parent ~= char then return end
    
    local usarCura = ServerStorage:FindFirstChild("UsarCura")
    local curaAtiva = ServerStorage:FindFirstChild("CuraAtiva")
    if not usarCura or not curaAtiva then
        warn("Bandagem: crie o script Efeitos (faltam UsarCura e CuraAtiva)")
        return
    end
    
    local inv = jogador:FindFirstChild("Inventario")
    local item = inv and inv:FindFirstChild(NOME_ITEM)
    if not item or item.Value < 1 then
        remote:FireClient(jogador, "aviso", "Você não tem " .. NOME_ITEM)
        return
    end
    
    if curaAtiva:Invoke(jogador) then
        remote:FireClient(jogador, "aviso", "Você já está se curando")
        return
    end
    
    usando = true
    remote:FireClient(jogador, "iniciar", TEMPO_USO)
    
    local cancelado = false
    local ultimaVida = hum.Health
    local passos = math.max(1, math.ceil(TEMPO_USO / 0.1))
    
    for _ = 1, passos do
        task.wait(0.1)
        
        if tool.Parent ~= char or hum.Health <= 0 then
            cancelado = true
            break
        end
        if CANCELAR_SE_DANO and hum.Health < ultimaVida - 0.01 then
            cancelado = true
            break
        end
        if CANCELAR_SE_MOVER and hum.MoveDirection.Magnitude > 0 then
            cancelado = true
            break
        end
        ultimaVida = hum.Health
    end
    
    if cancelado then
        remote:FireClient(jogador, "parar")
        remote:FireClient(jogador, "aviso", "Uso cancelado")
        usando = false
        return
    end
    
    -- gasta 1 bandagem e começa a curar (o script Efeitos cuida do resto)
    local erro = usarCura:Invoke(jogador, NOME_ITEM, CURA_POR_SEGUNDO, DURACAO)
    if erro then
        remote:FireClient(jogador, "parar")
        remote:FireClient(jogador, "aviso", erro)
    end
    usando = false
end)

]]></ProtectedString>
