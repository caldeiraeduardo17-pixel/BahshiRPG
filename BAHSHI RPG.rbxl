<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
 
local tool = script.Parent
local remote = tool:WaitForChild("Atacar")
local cdValor = tool:WaitForChild("CooldownAtual")
local treino = ServerStorage:WaitForChild("TreinarHabilidade")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local indicador = ReplicatedStorage:WaitForChild("Indicador")
 
-- ===== CONFIGURAÇÕES DA ESPADA =====
local DANO = 15.5
 
local COOLDOWN = 1.2 -- segundos entre ataques
local ALCANCE = 8 -- studs
 
-- bônus por nível da habilidade Espada (valores fixos)
local BONUS_DANO = 0.3 -- +0,3 de dano por nível
local BONUS_VELOCIDADE = 0.01 -- -0,01s de cooldown por nível
local COOLDOWN_MINIMO = 0.35
local SOM_ATAQUE_ID = "6230938036" -- cole o ID aqui (só o número ou "rbxassetid://...")
local VOLUME_ATAQUE = 0.8
-- ===================================
 
local ultimo = 0

local somAtaque = Instance.new("Sound")
somAtaque.Name = "SomAtaque"
somAtaque.Volume = VOLUME_ATAQUE
somAtaque.RollOffMaxDistance = 60
somAtaque.Parent = tool:FindFirstChild("Handle") or tool

if SOM_ATAQUE_ID ~= "" then
    local id = tostring(SOM_ATAQUE_ID)
    if tonumber(id) then
        id = "rbxassetid://" .. id
    end
    somAtaque.SoundId = id
end
 
local function nivelEspada(player)
    local h = player:FindFirstChild("Habilidades")
    local e = h and h:FindFirstChild("Espada")
    return e and e.Nivel.Value or 1
end
 
local function status(player)
    local n = nivelEspada(player) - 1
    local dano = DANO + n * BONUS_DANO
    local cd = math.max(COOLDOWN_MINIMO, COOLDOWN - n * BONUS_VELOCIDADE)
    return dano, cd
end
 
tool.Equipped:Connect(function()
    local player = Players:GetPlayerFromCharacter(tool.Parent)
    if player then
        local _, cd = status(player)
        cdValor.Value = cd
    end
end)
 
remote.OnServerEvent:Connect(function(player)
    local char = player.Character
    if not char or tool.Parent ~= char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    
    local dano, cd = status(player)
    cdValor.Value = cd
    
    
    -- valida o cooldown no servidor
    if tick() - ultimo < cd - 0.05 then return end
    ultimo = tick()
    if SOM_ATAQUE_ID ~= "" then
        somAtaque.PlaybackSpeed = 0.9 + math.random() * 0.2 -- varia um pouco o tom
        somAtaque:Play()
    end
    
    local params = OverlapParams.new()
    params.FilterDescendantsInstances = {char}
    
    local vistos = {}
    local acertou = false
    
    for _, parte in ipairs(workspace:GetPartBoundsInRadius(hrp.Position, ALCANCE, params)) do
        local modelo = parte:FindFirstAncestorOfClass("Model")
        local alvoHum = modelo and modelo:FindFirstChildOfClass("Humanoid")
        local alvoRaiz = modelo and modelo:FindFirstChild("HumanoidRootPart")
        
        if alvoHum and alvoRaiz and alvoHum.Health > 0
            and not vistos[modelo]
            and not Players:GetPlayerFromCharacter(modelo)
            and not string.find(modelo.Name, "^Loja_") then
            
            vistos[modelo] = true
            local direcao = (alvoRaiz.Position - hrp.Position).Unit
            -- só acerta quem está na frente
            if hrp.CFrame.LookVector:Dot(direcao) > 0.2 then
                alvoHum:TakeDamage(dano)
                indicador:FireClient(player, "dano", dano, alvoRaiz.Position + Vector3.new(0, 3, 0))
                acertou = true
            end
        end
    end
    
    if acertou then
        treino:Fire(player, "Espada", 1)
    end
end)
 
 
 
 

]]></ProtectedString>
