<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454103181AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LojaClient</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
 
local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("ConfigLojas"))
local abrirRemote = ReplicatedStorage:WaitForChild("AbrirLoja")
local transacaoRemote = ReplicatedStorage:WaitForChild("TransacaoLoja")
local avisoRemote = ReplicatedStorage:WaitForChild("AvisoLoja")
 
local ouro = player:WaitForChild("leaderstats"):WaitForChild("Ouro")
local inv = player:WaitForChild("Inventario")
 
-- ===== CONFIGURAÇÕES =====
local DISTANCIA_FECHAR = 20 -- fecha se você se afastar
local QTD_RAPIDA = 5        -- botão de compra rápida (x5)
local COR_FUNDO = Color3.fromRGB(40, 33, 26)
local COR_BOTAO = Color3.fromRGB(110, 80, 40)
local COR_INATIVO = Color3.fromRGB(70, 58, 46)
local COR_TEXTO = Color3.fromRGB(255, 230, 170)
-- =========================
 
local function novo(classe, props, pai)
    local o = Instance.new(classe)
    for k, v in pairs(props) do
        o[k] = v
    end
    o.Parent = pai
    return o
end
 
local function botaoPadrao(texto, props, pai)
    local p = {
    Text = texto,
    BackgroundColor3 = COR_BOTAO,
    BorderSizePixel = 0,
    TextColor3 = Color3.new(1, 1, 1),
    Font = Enum.Font.GothamBold,
    TextSize = 18,
    }
    for k, v in pairs(props) do
        p[k] = v
    end
    return novo("TextButton", p, pai)
end
 
local function cor(hex, texto)
    return '' .. texto .. ""
end
 
-- ===== TELA =====
local gui = novo("ScreenGui", {
Name = "LojaUI",
ResetOnSpawn = false,
DisplayOrder = 46,
Enabled = false,
}, player:WaitForChild("PlayerGui"))
 
local painel = novo("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.new(0.5, 0, 0.5, 0),
Size = UDim2.new(0.75, 0, 0.85, 0),
BackgroundColor3 = COR_FUNDO,
BorderSizePixel = 0,
Active = true,
}, gui)
 
local titulo = novo("TextLabel", {
Position = UDim2.new(0, 14, 0, 8),
Size = UDim2.new(0.5, 0, 0, 30),
BackgroundTransparency = 1,
Text = "",
TextColor3 = COR_TEXTO,
Font = Enum.Font.GothamBlack,
TextSize = 24,
TextXAlignment = Enum.TextXAlignment.Left,
}, painel)
 
local textoOuro = novo("TextLabel", {
AnchorPoint = Vector2.new(1, 0),
Position = UDim2.new(1, -60, 0, 8),
Size = UDim2.new(0.35, 0, 0, 30),
BackgroundTransparency = 1,
Text = "",
TextColor3 = Color3.fromRGB(255, 215, 90),
Font = Enum.Font.GothamBold,
TextSize = 20,
TextXAlignment = Enum.TextXAlignment.Right,
}, painel)
 
local botaoX = botaoPadrao("X", {
AnchorPoint = Vector2.new(1, 0),
Position = UDim2.new(1, -10, 0, 8),
Size = UDim2.new(0, 40, 0, 30),
BackgroundColor3 = Color3.fromRGB(150, 40, 40),
}, painel)
 
local botaoComprar = botaoPadrao("Comprar", {
Position = UDim2.new(0, 14, 0, 48),
Size = UDim2.new(0, 120, 0, 34),
}, painel)
 
local botaoVender = botaoPadrao("Vender", {
Position = UDim2.new(0, 142, 0, 48),
Size = UDim2.new(0, 120, 0, 34),
}, painel)
 
local lista = novo("ScrollingFrame", {
Position = UDim2.new(0, 14, 0, 92),
Size = UDim2.new(1, -28, 1, -134),
BackgroundColor3 = Color3.fromRGB(28, 23, 18),
BorderSizePixel = 0,
ScrollBarThickness = 6,
CanvasSize = UDim2.new(),
AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, painel)
 
novo("UIListLayout", {
Padding = UDim.new(0, 4),
SortOrder = Enum.SortOrder.LayoutOrder,
}, lista)
 
local status = novo("TextLabel", {
AnchorPoint = Vector2.new(0, 1),
Position = UDim2.new(0, 14, 1, -8),
Size = UDim2.new(1, -28, 0, 26),
BackgroundTransparency = 1,
Text = "",
TextColor3 = Color3.new(1, 1, 1),
Font = Enum.Font.GothamBold,
TextSize = 16,
TextXAlignment = Enum.TextXAlignment.Left,
}, painel)
 
-- ===== ESTADO =====
local lojaId = nil
local loja = nil
local alvo = nil
local aba = "comprar"
local ultima = ""
local statusId = 0
 
local function mostrarStatus(texto, ok)
    statusId += 1
    local meu = statusId
    status.Text = texto
    status.TextColor3 = ok and Color3.fromRGB(130, 230, 130) or Color3.fromRGB(255, 120, 120)
    task.delay(2.5, function()
        if meu == statusId then
            status.Text = ""
        end
    end)
end
 
avisoRemote.OnClientEvent:Connect(mostrarStatus)
 
local function qtdTenho(nome)
    local v = inv:FindFirstChild(nome)
    return v and v.Value or 0
end
 
local function criarLinha(ordem, texto, botoes)
    local linha = novo("Frame", {
    LayoutOrder = ordem,
    Size = UDim2.new(1, -8, 0, 52),
    BackgroundColor3 = Color3.fromRGB(55, 46, 38),
    BorderSizePixel = 0,
    }, lista)
    
    novo("TextLabel", {
    Position = UDim2.new(0, 10, 0, 0),
    Size = UDim2.new(1, -190, 1, 0),
    BackgroundTransparency = 1,
    RichText = true,
    Text = texto,
    TextColor3 = Color3.new(1, 1, 1),
    Font = Enum.Font.GothamMedium,
    TextSize = 15,
    TextWrapped = true,
    TextXAlignment = Enum.TextXAlignment.Left,
    }, linha)
    
    for i, b in ipairs(botoes) do
        local x = botaoPadrao(b.texto, {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8 - (#botoes - i) * 78, 0.5, 0),
        Size = UDim2.new(0, 72, 0, 34),
        TextSize = 16,
        }, linha)
        x.Activated:Connect(b.aoClicar)
    end
end
 
local function redesenhar()
    for _, f in ipairs(lista:GetChildren()) do
        if f:IsA("GuiObject") then
            f:Destroy()
        end
    end
    if not loja then return end
    
    textoOuro.Text = "Ouro: " .. ouro.Value
    botaoComprar.BackgroundColor3 = (aba == "comprar") and COR_BOTAO or COR_INATIVO
    botaoVender.BackgroundColor3 = (aba == "vender") and COR_BOTAO or COR_INATIVO
    
    local ordem = 0
    
    if aba == "comprar" then
        for _, e in ipairs(loja.vende or {}) do
            ordem += 1
            local corPreco = (ouro.Value >= e.preco) and "#ffd75a" or "#ff6a5a"
            local texto = e.item .. "\n" .. cor(corPreco, e.preco .. " ouro")
            local tenho = qtdTenho(e.item)
            if tenho > 0 then
                texto = texto .. cor("#aaaaaa", "   (você tem " .. tenho .. ")")
            end
            
            criarLinha(ordem, texto, {
            {texto = "x1", aoClicar = function()
                transacaoRemote:FireServer(lojaId, "comprar", e.item, 1)
            end},
            {texto = "x" .. QTD_RAPIDA, aoClicar = function()
                transacaoRemote:FireServer(lojaId, "comprar", e.item, QTD_RAPIDA)
            end},
            })
        end
        if ordem == 0 then
            criarLinha(1, "Esta loja não vende nada.", {})
        end
    else
        for _, e in ipairs(loja.compra or {}) do
            local tenho = qtdTenho(e.item)
            if tenho > 0 then
                ordem += 1
                local texto = e.item .. "  x" .. tenho .. "\n" .. cor("#ffd75a", e.preco .. " ouro cada")
                
                criarLinha(ordem, texto, {
                {texto = "x1", aoClicar = function()
                    transacaoRemote:FireServer(lojaId, "vender", e.item, 1)
                end},
                {texto = "Tudo", aoClicar = function()
                    transacaoRemote:FireServer(lojaId, "vender", e.item, math.min(qtdTenho(e.item), 999))
                end},
                })
            end
        end
        if ordem == 0 then
            criarLinha(1, "Você não tem nada que esta loja compre.", {})
        end
    end
end
 
local function assinatura()
    local p = {tostring(ouro.Value), aba, lojaId or ""}
    for _, i in ipairs(inv:GetChildren()) do
        table.insert(p, i.Name .. "=" .. i.Value)
    end
    return table.concat(p, ";")
end
 
local function fechar()
    gui.Enabled = false
    loja = nil
    lojaId = nil
    alvo = nil
    ultima = ""
end
 
botaoX.Activated:Connect(fechar)
 
botaoComprar.Activated:Connect(function()
    aba = "comprar"
    ultima = ""
end)
 
botaoVender.Activated:Connect(function()
    aba = "vender"
    ultima = ""
end)
 
abrirRemote.OnClientEvent:Connect(function(id, parte)
    if type(id) ~= "string" or typeof(parte) ~= "Instance" then return end
    
    local dados = Config[id]
    if not dados then return end
    
    lojaId = id
    loja = dados
    alvo = parte
    titulo.Text = dados.nome or id
    status.Text = ""
    
    local temVende = dados.vende ~= nil and #dados.vende > 0
    local temCompra = dados.compra ~= nil and #dados.compra > 0
    botaoComprar.Visible = temVende
    botaoVender.Visible = temCompra
    aba = temVende and "comprar" or "vender"
    
    ultima = ""
    gui.Enabled = true
end)
 
-- atualiza a lista e fecha se você morrer, tomar dano ou se afastar
task.spawn(function()
    local vidaAntes = 0
    while true do
        if gui.Enabled then
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            if not hum or not hrp or hum.Health <= 0
                or not alvo or not alvo.Parent
                or (hrp.Position - alvo.Position).Magnitude > DISTANCIA_FECHAR
                or hum.Health < vidaAntes - 0.01 then
                fechar()
            else
                vidaAntes = hum.Health
                local s = assinatura()
                if s ~= ultima then
                    ultima = s
                    redesenhar()
                end
            end
        else
            vidaAntes = 0
        end
        task.wait(0.2)
    end
end)

]]></ProtectedString>
