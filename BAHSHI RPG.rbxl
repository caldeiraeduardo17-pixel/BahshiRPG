<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454103213AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">StatusScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local player = Players.LocalPlayer

local hud = script.Parent
local painel = hud:WaitForChild("PainelInventario")
local texto = painel:WaitForChild("StatusTexto")
local botaoItens = painel:WaitForChild("BotaoAbaItens")
local botaoStatus = painel:WaitForChild("BotaoAbaStatus")

-- tudo que pertence à aba Itens (já existe, não precisa mover)
local abaItens = {
painel:WaitForChild("Capacidade"),
painel:WaitForChild("BotaoMelhorar"),
painel:WaitForChild("ListaItens"),
}

-- iguais aos do EspadaServer (se mudar lá, mude aqui)
local DANO_BASE = 10
local BONUS_DANO = 0.3
local COOLDOWN_BASE = 1.0
local BONUS_VELOCIDADE = 0.01
local COOLDOWN_MINIMO = 0.35

texto.RichText = true

local function nivelDe(nome)
    local pasta = player:FindFirstChild("Habilidades")
    local h = pasta and pasta:FindFirstChild(nome)
    local n = h and h:FindFirstChild("Nivel")
    return n and n.Value or 1
end

local function atualizar()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    local nEspada = nivelDe("Espada") - 1
    local dano = DANO_BASE + nEspada * BONUS_DANO
    local cd = math.max(COOLDOWN_MINIMO, COOLDOWN_BASE - nEspada * BONUS_VELOCIDADE)
    local reducao = math.min(70, nivelDe("Defesa"))
    
    local cheia = player:FindFirstChild("MochilaCheia")
    local mochila = player:FindFirstChild("Mochila")
    
    local linhas = {
    string.format("Vida máxima: %d", math.ceil(hum.MaxHealth)),
    string.format("Velocidade: %.1f", hum.WalkSpeed),
    string.format("Dano da espada: %.1f", dano),
    string.format("Ataque a cada: %.2fs", cd),
    string.format("Redução de dano: %d%%", reducao),
    }
    
    if mochila then
        table.insert(linhas, string.format("Mochila: %d / %d slots",
        mochila.SlotsUsados.Value, mochila.SlotsTotal.Value))
    end
    
    if cheia and cheia.Value then
        table.insert(linhas, 'Mochila cheia: você está mais lento!')
    end
    
    texto.Text = table.concat(linhas, "\n")
end

local abaAtual = "Itens"

local function mostrarAba(nome)
    abaAtual = nome
    for _, obj in ipairs(abaItens) do
        obj.Visible = (nome == "Itens")
    end
    texto.Visible = (nome == "Status")
    if nome == "Status" then
        atualizar()
    end
end

botaoItens.Activated:Connect(function()
    mostrarAba("Itens")
end)

botaoStatus.Activated:Connect(function()
    mostrarAba("Status")
end)

-- atualiza enquanto a aba Status estiver aberta
task.spawn(function()
    while true do
        if painel.Visible and abaAtual == "Status" then
            atualizar()
        end
        task.wait(0.25)
    end
end)

mostrarAba("Itens")

]]></ProtectedString>
