<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454103291AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">PainelScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local player = Players.LocalPlayer
 
local hud = script.Parent
local painel = hud:WaitForChild("PainelHabilidades")
local lista = painel:WaitForChild("Lista")
local modelo = lista:WaitForChild("ModeloLinha")
local botao = hud:WaitForChild("BotaoHabilidades")
local pasta = player:WaitForChild("Habilidades")
 
modelo.Visible = false
 
botao.Activated:Connect(function()
    painel.Visible = not painel.Visible
end)
 
local function criarLinha(h)
    local nivel = h:WaitForChild("Nivel")
    local xp = h:WaitForChild("XP")
    local meta = h:WaitForChild("Precisa")
    
    local linha = modelo:Clone()
    linha.Name = h.Name
    linha.Visible = true
    
    local nome = linha:WaitForChild("Nome")
    local nivelTexto = linha:WaitForChild("NivelTexto")
    local fundo = linha:FindFirstChild("BarraFundo")
    local barra = fundo and fundo:FindFirstChild("Barra")
    
    local function atualizar()
        local precisa = math.max(1, meta.Value)
        nome.Text = h.Name
        nivelTexto.Text = " " .. nivel.Value
        if barra then
            barra.Size = UDim2.new(math.clamp(xp.Value / precisa, 0, 1), 0, 1, 0)
        end
    end
    
    nivel.Changed:Connect(atualizar)
    xp.Changed:Connect(atualizar)
    meta.Changed:Connect(atualizar)
    atualizar()
    
    linha.Parent = lista
end
 
for _, h in ipairs(pasta:GetChildren()) do
    criarLinha(h)
end
pasta.ChildAdded:Connect(criarLinha)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940329200437f</UniqueId>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454103293AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">HUDScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local player = Players.LocalPlayer
 
local hud = script.Parent
local textoOuro = hud:WaitForChild("Ouro")
local textoNivel = hud:WaitForChild("Nivel")
local textoXP = hud:WaitForChild("XPTexto")
local fundo = hud:FindFirstChild("XPFundo")
local barra = fundo and fundo:FindFirstChild("XPBarra")
 
local stats = player:WaitForChild("leaderstats")
local ouro = stats:WaitForChild("Ouro")
local nivel = stats:WaitForChild("Nivel")
local xp = stats:WaitForChild("XP")
 
local function atualizar()
    local precisa = nivel.Value * 100
    
    textoOuro.Text = "$ " .. ouro.Value
    textoNivel.Text = "Nv " .. nivel.Value
    textoXP.Text = xp.Value .. " / " .. precisa .. " XP"
    
    if barra then
        barra:TweenSize(
        UDim2.new(math.clamp(xp.Value / precisa, 0, 1), 0, 1, 0),
        Enum.EasingDirection.Out,
        Enum.EasingStyle.Quad,
        0.3,
        true
        )
    end
end
 
ouro.Changed:Connect(atualizar)
nivel.Changed:Connect(atualizar)
xp.Changed:Connect(atualizar)
atualizar()

]]></ProtectedString>
