<Item class="Script" referent="RBX66C1625455D04AC580D8103323513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Inventario</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local DEBUG = true -- mostra no Output quantos slots cada item gasta (desligue depois)
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
 
-- ===== CONFIGURAÇÕES =====
local PILHA = 10            -- itens por slot
local SLOTS_INICIAIS = 5
local SLOTS_POR_NIVEL = 3   -- slots ganhos por upgrade
local NIVEL_MAX = 10
-- =========================
local darItem = Instance.new("BindableFunction")
darItem.Name = "DarItem"
darItem.Parent = ServerStorage
 
local melhorarRemote = Instance.new("RemoteEvent")
local indicador = ReplicatedStorage:WaitForChild("Indicador")
melhorarRemote.Name = "MelhorarMochila"
melhorarRemote.Parent = ReplicatedStorage
local pilhaValor = Instance.new("IntValue")
pilhaValor.Name = "TamanhoPilha"
pilhaValor.Value = PILHA
pilhaValor.Parent = ReplicatedStorage
 
local function slotsTotal(nivel)
    return SLOTS_INICIAIS + (nivel - 1) * SLOTS_POR_NIVEL
end
 
local function custoUpgrade(nivel)
    return nivel * 50
end
local function pilhaDe(nome)
    local equipaveis = ServerStorage:FindFirstChild("Equipaveis")
    local modelo = equipaveis and equipaveis:FindFirstChild(nome)
    if modelo and not modelo:FindFirstChild("Empilhavel") then
        return 1 -- equipamento não empilha: 1 por slot
    end
    return PILHA
end
local function recalcular(player)
    local inv = player:FindFirstChild("Inventario")
    local m = player:FindFirstChild("Mochila")
    if not inv or not m then return end
    
    -- junta itens repetidos (mesmo nome)
    local vistos = {}
    for _, item in ipairs(inv:GetChildren()) do
        local primeiro = vistos[item.Name]
        if primeiro then
            if pilhaDe(item.Name) == 1 then
                primeiro.Value = math.max(primeiro.Value, item.Value)
            else
                primeiro.Value += item.Value
            end
            item:Destroy()
        else
            vistos[item.Name] = item
        end
    end
    
    local usados = 0
    for nome, item in pairs(vistos) do
        local gasta = math.ceil(item.Value / pilhaDe(nome))
        usados += gasta
        if DEBUG then
            print("Mochila: " .. nome .. " x" .. item.Value .. " = " .. gasta .. " slot(s)")
        end
    end
    
    local total = slotsTotal(m.Nivel.Value)
    m.SlotsUsados.Value = usados
    m.SlotsTotal.Value = total
    m.Custo.Value = (m.Nivel.Value >= NIVEL_MAX) and 0 or custoUpgrade(m.Nivel.Value)
    
    local cheia = player:FindFirstChild("MochilaCheia")
    if cheia then
        cheia.Value = usados >= total
    end
end
 
-- outros scripts usam: DarItem:Invoke(player, "Nome", quantidade)
darItem.OnInvoke = function(player, nome, qtd)
    local inv = player:FindFirstChild("Inventario")
    local m = player:FindFirstChild("Mochila")
    if not inv or not m then return 0 end
    
    local item = inv:FindFirstChild(nome)
    local atual = item and item.Value or 0
    
    local pilha = pilhaDe(nome)
    local slotsLivres = m.SlotsTotal.Value - m.SlotsUsados.Value
    local sobraNaPilha = math.ceil(atual / pilha) * pilha - atual
    local cabe = slotsLivres * pilha + sobraNaPilha
    
    local add = math.min(qtd, cabe)
    if add <= 0 then
        indicador:FireClient(player, "cheia")
        return 0
    end
    
    if not item then
        item = Instance.new("IntValue")
        item.Name = nome
        item.Parent = inv
    end
    item.Value += add
    recalcular(player)
    indicador:FireClient(player, "item", nome, add)
    return add
end
local tirarItem = Instance.new("BindableFunction")
tirarItem.Name = "TirarItem"
tirarItem.Parent = ServerStorage
 
tirarItem.OnInvoke = function(player, nome, qtd)
    local inv = player:FindFirstChild("Inventario")
    local item = inv and inv:FindFirstChild(nome)
    if not item then return 0 end
    
    local tira = math.min(qtd, item.Value)
    item.Value -= tira
    if item.Value <= 0 then
        item:Destroy()
    end
    recalcular(player)
    return tira
end
local recalcFn = Instance.new("BindableFunction")
recalcFn.Name = "Recalcular"
recalcFn.Parent = ServerStorage
recalcFn.OnInvoke = function(player)
    recalcular(player)
end
melhorarRemote.OnServerEvent:Connect(function(player)
    local m = player:FindFirstChild("Mochila")
    local stats = player:FindFirstChild("leaderstats")
    if not m or not stats then return end
    if m.Nivel.Value >= NIVEL_MAX then return end
    
    local custo = custoUpgrade(m.Nivel.Value)
    if stats.Ouro.Value < custo then return end
    
    stats.Ouro.Value -= custo
    m.Nivel.Value += 1
    recalcular(player)
end)
 
local function valor(nome, v, pai)
    local x = Instance.new("IntValue")
    x.Name = nome
    x.Value = v
    x.Parent = pai
end
 
Players.PlayerAdded:Connect(function(player)
    local inv = Instance.new("Folder")
    inv.Name = "Inventario"
    inv.Parent = player
    
    local m = Instance.new("Folder")
    m.Name = "Mochila"
    valor("Nivel", 1, m)
    valor("SlotsUsados", 0, m)
    valor("SlotsTotal", SLOTS_INICIAIS, m)
    valor("Custo", custoUpgrade(1), m)
    m.Parent = player
    
    -- equipa a espada sozinha (a barrinha padrão do Roblox vai sumir)
    player.CharacterAdded:Connect(function(char)
        local hum = char:WaitForChild("Humanoid")
        local espada = player:WaitForChild("Backpack"):WaitForChild("EspadaPadrao", 5)
        if espada then
            hum:EquipTool(espada)
        end
    end)
end)

]]></ProtectedString>
