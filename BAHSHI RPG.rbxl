<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
 
local tool = script.Parent
local remote = tool:WaitForChild("Atacar")
local player = Players.LocalPlayer
 
-- ===== CONFIGURAÇÕES =====
local COOLDOWN_PADRAO = 0.5   -- usado só até o servidor responder
local MOSTRAR_COMBO = true    -- mostra "Combo x3" acima da barra
-- =========================
 
-- ===== ANIMAÇÕES (uma pra cada mão) =====
local ANIM_DIREITA_ID = ""          -- ID da animação do golpe da mão DIREITA
local ANIM_DIREITA_KEYFRAME = "rightswing"    -- ou o nome de um KeyframeSequence dentro da Tool (só no teste do Studio)
local ANIM_ESQUERDA_ID = "1000959"         -- ID da animação do golpe da mão ESQUERDA
local ANIM_ESQUERDA_KEYFRAME = "leftswing"   -- ou o nome de um KeyframeSequence dentro da Tool (só no teste do Studio)
local ANIM_VELOCIDADE = 1           -- 1 = normal, 2 = o dobro da velocidade
 
local Animacao = nil
task.spawn(function()
    local modulo = game:GetService("ReplicatedStorage"):WaitForChild("Animacao", 10)
    if not modulo then
        warn("Animação: não achei o ModuleScript 'Animacao' em ReplicatedStorage (confira o nome)")
        return
    end
    local ok, resultado = pcall(require, modulo)
    if ok then
        Animacao = resultado
    else
        warn("Animação: erro dentro do ModuleScript Animacao: " .. tostring(resultado))
    end
end)
 
local function tocarAnimacao(mao)
    if not Animacao then return end
    
    local id = (mao == 1) and ANIM_DIREITA_ID or ANIM_ESQUERDA_ID
    local nomeKs = (mao == 1) and ANIM_DIREITA_KEYFRAME or ANIM_ESQUERDA_KEYFRAME
    
    local ok, erro = pcall(function()
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        
        Animacao.tocar(hum, {
        id = id,
        keyframe = (nomeKs ~= "") and tool:FindFirstChild(nomeKs) or nil,
        velocidade = ANIM_VELOCIDADE,
        })
    end)
    if not ok then
        warn("Animação: " .. tostring(erro))
    end
end
-- ========================================
 
local gui = nil
local barra = nil
local textoCombo = nil
local proximo = 0
local sessaoCombo = 0
 
local function criarGui()
    gui = Instance.new("ScreenGui")
    gui.Name = "BarraAtaque"
    gui.ResetOnSpawn = false
    
    local fundo = Instance.new("Frame")
    fundo.Name = "Fundo"
    fundo.AnchorPoint = Vector2.new(0.5, 1)
    fundo.Position = UDim2.new(0.5, 0, 0.85, 0)
    fundo.Size = UDim2.new(0, 200, 0, 10)
    fundo.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    fundo.BorderSizePixel = 0
    fundo.Parent = gui
    
    barra = Instance.new("Frame")
    barra.Name = "Barra"
    barra.Size = UDim2.new(1, 0, 1, 0)
    barra.BackgroundColor3 = Color3.fromRGB(230, 190, 60)
    barra.BorderSizePixel = 0
    barra.Parent = fundo
    
    textoCombo = Instance.new("TextLabel")
    textoCombo.AnchorPoint = Vector2.new(0.5, 1)
    textoCombo.Position = UDim2.new(0.5, 0, 0.85, -14)
    textoCombo.Size = UDim2.new(0, 200, 0, 22)
    textoCombo.BackgroundTransparency = 1
    textoCombo.Text = ""
    textoCombo.TextColor3 = Color3.fromRGB(255, 220, 130)
    textoCombo.TextStrokeTransparency = 0.4
    textoCombo.Font = Enum.Font.GothamBold
    textoCombo.TextSize = 16
    textoCombo.Parent = gui
    
    gui.Parent = player:WaitForChild("PlayerGui")
end
 
local function limparGui()
    if gui then
        gui:Destroy()
        gui = nil
    end
    barra = nil
    textoCombo = nil
end
 
tool.Equipped:Connect(criarGui)
tool.Unequipped:Connect(limparGui)
 
tool.AncestryChanged:Connect(function(_, pai)
    if not pai then
        limparGui()
    end
end)
 
tool.Activated:Connect(function()
    if tick() < proximo then return end
    proximo = tick() + COOLDOWN_PADRAO -- provisório, o servidor confirma depois
    remote:FireServer()
end)
 
-- o servidor diz qual mão atacou
remote.OnClientEvent:Connect(function(tipo, mao, cd, combo)
    if tipo ~= "golpe" then return end
    
    proximo = tick() + cd
    tocarAnimacao(mao)
    
    if barra then
        barra.Size = UDim2.new(0, 0, 1, 0)
        TweenService:Create(
        barra,
        TweenInfo.new(cd, Enum.EasingStyle.Linear),
        {Size = UDim2.new(1, 0, 1, 0)}
        ):Play()
    end
    
    if textoCombo and MOSTRAR_COMBO then
        sessaoCombo += 1
        local meu = sessaoCombo
        textoCombo.Text = (combo >= 2) and ("Combo x" .. combo) or ""
        task.delay(1.5, function()
            if meu == sessaoCombo and textoCombo then
                textoCombo.Text = ""
            end
        end)
    end
end)

]]></ProtectedString>
