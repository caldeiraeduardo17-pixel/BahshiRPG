<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
 
local tool = script.Parent
local remote = tool:WaitForChild("Usar")
local player = Players.LocalPlayer
-- ===== ANIMAÇÃO DE ATAQUE =====
local ANIM_ID = "11236416817"          -- OPÇÃO 1: ID da animação publicada (só o número ou "rbxassetid://...")
local ANIM_KEYFRAME = ""    -- OPÇÃO 2: nome de um KeyframeSequence dentro da Tool (só no teste do Studio)
local ANIM_VELOCIDADE = 1   -- 1 = normal, 2 = o dobro da velocidade

local Animacao = nil
task.spawn(function()
    local modulo = game:GetService("ReplicatedStorage"):WaitForChild("Animacao", 10)
    if not modulo then
        warn("Animação: não achei o ModuleScript 'Animacao' em ReplicatedStorage (confira o nome)")
        return
    end
    local ok, resultado = pcall(require, modulo)
    if ok then
        Animacao = resultado
        print("Animação: módulo carregado")
    else
        warn("Animação: erro dentro do ModuleScript Animacao: " .. tostring(resultado))
    end
end)

local function tocarAnimacao()
    if not Animacao then return end
    
    local ok, erro = pcall(function()
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        
        Animacao.tocar(hum, {
        id = ANIM_ID,
        keyframe = (ANIM_KEYFRAME ~= "") and tool:FindFirstChild(ANIM_KEYFRAME) or nil,
        velocidade = ANIM_VELOCIDADE,
        })
    end)
    if not ok then
        warn("Animação: " .. tostring(erro))
    end
end
-- ==============================

local gui = nil
local barra = nil
local texto = nil
local fundo = nil
local tween = nil
local sessao = 0
local ultimoClique = 0
 

local function limpar()
    sessao += 1
    if tween then
        tween:Cancel()
        tween = nil
    end
    if gui then
        gui:Destroy()
        gui = nil
    end
end
 
local function criarGui()
    gui = Instance.new("ScreenGui")
    gui.Name = "BarraBandagem"
    gui.ResetOnSpawn = false
    gui.Parent = player:WaitForChild("PlayerGui")
    
    fundo = Instance.new("Frame")
    fundo.AnchorPoint = Vector2.new(0.5, 1)
    fundo.Position = UDim2.new(0.5, 0, 0.85, 0)
    fundo.Size = UDim2.new(0, 200, 0, 10)
    fundo.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    fundo.BorderSizePixel = 0
    fundo.Parent = gui
    
    barra = Instance.new("Frame")
    barra.Size = UDim2.new(0, 0, 1, 0)
    barra.BackgroundColor3 = Color3.fromRGB(120, 210, 120)
    barra.BorderSizePixel = 0
    barra.Parent = fundo
    
    texto = Instance.new("TextLabel")
    texto.AnchorPoint = Vector2.new(0.5, 1)
    texto.Position = UDim2.new(0.5, 0, 0.85, -14)
    texto.Size = UDim2.new(0, 260, 0, 20)
    texto.BackgroundTransparency = 1
    texto.TextColor3 = Color3.new(1, 1, 1)
    texto.TextStrokeTransparency = 0.4
    texto.Font = Enum.Font.GothamBold
    texto.TextSize = 14
    texto.Text = ""
    texto.Parent = gui
end
 
remote.OnClientEvent:Connect(function(tipo, valor)
    if tipo == "iniciar" then
        limpar()
        criarGui()
        texto.Text = "Aplicando bandagem..."
        tween = TweenService:Create(
        barra,
        TweenInfo.new(valor, Enum.EasingStyle.Linear),
        {Size = UDim2.new(1, 0, 1, 0)}
        )
        tween:Play()
        
        local meu = sessao
        task.delay(valor + 0.3, function()
            if meu == sessao then
                limpar()
            end
        end)
        
    elseif tipo == "parar" then
        limpar()
        
    elseif tipo == "aviso" then
        limpar()
        criarGui()
        fundo.Visible = false
        texto.Text = valor
        texto.TextColor3 = Color3.fromRGB(255, 120, 120)
        
        local meu = sessao
        task.delay(1.5, function()
            if meu == sessao then
                limpar()
            end
        end)
    end
end)
 
tool.Activated:Connect(function()
    if tick() - ultimoClique < 0.4 then return end
    ultimoClique = tick()
    remote:FireServer()
end)
 
tool.Unequipped:Connect(limpar)
 
tool.AncestryChanged:Connect(function(_, pai)
    if not pai then
        limpar()
    end
end)

]]></ProtectedString>
