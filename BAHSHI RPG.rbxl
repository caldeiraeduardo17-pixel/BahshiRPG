<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454103279AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">AvisoScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
 
local hud = script.Parent
local aviso = hud:WaitForChild("AvisoHabilidade")
local evento = ReplicatedStorage:WaitForChild("HabilidadeSubiu")
 
-- ===== CONFIGURAÇÕES =====
local SOM_ID = "99905648915147" -- cole o ID aqui, ex: "99905648915147" ou só o número
local VOLUME = 0.6
local DISTANCIA = 60 -- quantos pixels desliza pros lados
local TEMPO_ENTRADA = 0.4
local TEMPO_PARADO = 1.5
local TEMPO_SAIDA = 0.4
-- =========================
 
-- cria o som
local som = Instance.new("Sound")
som.Name = "SomAviso"
som.Volume = VOLUME
som.Parent = aviso
 
if SOM_ID ~= "" then
    local id = tostring(SOM_ID)
    if tonumber(id) then
        id = "rbxassetid://" .. id
    end
    som.SoundId = id
end
 
-- guarda a posição que você deixou no editor
local posFinal = aviso.Position
 
local function deslocar(pos, x)
    return UDim2.new(pos.X.Scale, pos.X.Offset + x, pos.Y.Scale, pos.Y.Offset)
end
 
local contador = 0
local tweenAtual = nil
 
evento.OnClientEvent:Connect(function(nome, nivel)
    contador += 1
    local meu = contador
    
    if tweenAtual then
        tweenAtual:Cancel()
    end
    
    -- prepara: começa à esquerda e invisível
    aviso.Text = nome .. " +1 (" .. nivel .. ")"
    aviso.Position = deslocar(posFinal, -DISTANCIA)
    aviso.TextTransparency = 1
    aviso.Visible = true
    
    if SOM_ID ~= "" then
        som:Play()
    end
    
    -- ENTRADA: esquerda -> centro, fade in
    tweenAtual = TweenService:Create(
    aviso,
    TweenInfo.new(TEMPO_ENTRADA, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    {Position = posFinal, TextTransparency = 0}
    )
    tweenAtual:Play()
    tweenAtual.Completed:Wait()
    if meu ~= contador then return end
    
    -- fica parado
    task.wait(TEMPO_PARADO)
    if meu ~= contador then return end
    
    -- SAÍDA: centro -> direita, fade out
    tweenAtual = TweenService:Create(
    aviso,
    TweenInfo.new(TEMPO_SAIDA, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
    {Position = deslocar(posFinal, DISTANCIA), TextTransparency = 1}
    )
    tweenAtual:Play()
    tweenAtual.Completed:Wait()
    if meu ~= contador then return end
    
    aviso.Visible = false
    aviso.Position = posFinal
end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940328000437f</UniqueId>
</Properties>
</Item>
