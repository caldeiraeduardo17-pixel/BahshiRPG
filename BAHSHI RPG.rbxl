<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
 
local player = Players.LocalPlayer
local usarRemote = ReplicatedStorage:WaitForChild("UsarSlot")
local slotsPasta = player:WaitForChild("Slots")
local inv = player:WaitForChild("Inventario")
 
local NUM_SLOTS = 4
local COR_NORMAL = Color3.fromRGB(45, 38, 31)
local COR_ATIVO = Color3.fromRGB(150, 115, 40)
 
local gui = Instance.new("ScreenGui")
gui.Name = "Hotbar"
gui.ResetOnSpawn = false
gui.DisplayOrder = 20
gui.Parent = player:WaitForChild("PlayerGui")
 
local barra = Instance.new("Frame")
barra.AnchorPoint = Vector2.new(0.5, 1)
barra.Position = UDim2.new(0.5, 0, 1, -12)
barra.Size = UDim2.new(0, NUM_SLOTS * 70 + (NUM_SLOTS - 1) * 6, 0, 60)
barra.BackgroundTransparency = 1
barra.Parent = gui
 
local layout = Instance.new("UIListLayout")
layout.FillDirection = Enum.FillDirection.Horizontal
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = barra
 
local botoes = {}
 
for i = 1, NUM_SLOTS do
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 70, 0, 60)
    b.LayoutOrder = i
    b.BackgroundColor3 = COR_NORMAL
    b.BorderSizePixel = 0
    b.Text = ""
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 13
    b.TextWrapped = true
    b.Parent = barra
 
    local n = Instance.new("TextLabel")
    n.Size = UDim2.new(0, 16, 0, 16)
    n.Position = UDim2.new(0, 3, 0, 2)
    n.BackgroundTransparency = 1
    n.Text = tostring(i)
    n.TextColor3 = Color3.fromRGB(255, 220, 130)
    n.Font = Enum.Font.GothamBold
    n.TextSize = 12
    n.Parent = b
 
    b.Activated:Connect(function()
        usarRemote:FireServer(i)
    end)
 
    botoes[i] = b
end
 
-- teclas 1 a 4 (PC)
local teclas = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}
UserInputService.InputBegan:Connect(function(input, processado)
    if processado then return end
    for i, k in ipairs(teclas) do
        if input.KeyCode == k and i <= NUM_SLOTS then
            usarRemote:FireServer(i)
        end
    end
end)
 
-- atualiza nome, quantidade e destaque
task.spawn(function()
    while true do
        local char = player.Character
        local segurando = char and char:FindFirstChildOfClass("Tool")
 
        for i = 1, NUM_SLOTS do
            local v = slotsPasta:FindFirstChild(tostring(i))
            local nome = v and v.Value or ""
            local b = botoes[i]
 
            if nome == "" then
                b.Text = ""
                b.BackgroundColor3 = COR_NORMAL
            else
                local item = inv:FindFirstChild(nome)
                local qtd = item and item.Value or 0
                b.Text = (qtd > 1) and (nome .. "\nx" .. qtd) or nome
                b.BackgroundColor3 = (segurando and segurando.Name == nome) and COR_ATIVO or COR_NORMAL
            end
        end
 
        task.wait(0.15)
    end
end)

]]></ProtectedString>
