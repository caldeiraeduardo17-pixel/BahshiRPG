<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454103201AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">IndicadorAviso</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
 
local player = Players.LocalPlayer
local evento = ReplicatedStorage:WaitForChild("Indicador")
 
-- ===== CONFIGURAÇÕES =====
local TEMPO_ITEM = 2.5 -- segundos até o aviso do item sumir
local COR_DANO = Color3.fromRGB(255, 220, 80)
local COR_ITEM = Color3.fromRGB(255, 255, 255)
local COR_AVISO = Color3.fromRGB(255, 90, 90)
local COR_GANHO = Color3.fromRGB(255, 215, 60)
local COR_PERDA = Color3.fromRGB(255, 90, 90)
local COR_XP = Color3.fromRGB(120, 200, 255)
 
-- ===== SOM DE NÍVEL =====
local SOM_NIVEL_ID = "96102213526905" -- cole o ID aqui (só o número ou "rbxassetid://...")
local VOLUME_NIVEL = 0.8
-- =========================
 
local gui = Instance.new("ScreenGui")
gui.Name = "Indicadores"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")
 
local lista = Instance.new("Frame")
lista.AnchorPoint = Vector2.new(0, 1)
lista.Position = UDim2.new(0.3, 0, 0.5, 0)
lista.Size = UDim2.new(0, 250, 0, 200)
lista.BackgroundTransparency = 1
lista.Parent = gui
 
local layout = Instance.new("UIListLayout")
layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
layout.Padding = UDim.new(0, 2)
layout.Parent = lista
 
-- ===== AVISOS QUE ACUMULAM =====
local ativos = {}
 
local function empilhar(chave, qtd, formato, cor)
    local a = ativos[chave]
    if not a then
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, 0, 0, 24)
        l.BackgroundTransparency = 1
        l.TextXAlignment = Enum.TextXAlignment.Center
        l.Font = Enum.Font.GothamBold
        l.TextSize = 18
        l.TextColor3 = cor
        l.Parent = lista
        a = {label = l, total = 0, id = 0}
        ativos[chave] = a
    end
    
    if a.tween then a.tween:Cancel() end
    
    a.total += qtd
    a.id += 1
    local meu = a.id
    
    a.label.Text = formato(a.total)
    a.label.TextTransparency = 0
    a.label.TextStrokeTransparency = 0.4
    
    task.delay(TEMPO_ITEM, function()
        if a.id ~= meu then return end
        a.tween = TweenService:Create(a.label, TweenInfo.new(0.4),
        {TextTransparency = 1, TextStrokeTransparency = 1})
        a.tween:Play()
        a.tween.Completed:Wait()
        if a.id ~= meu then return end
        a.label:Destroy()
        ativos[chave] = nil
    end)
end
 
-- ===== NÚMERO DE DANO =====
local function mostrarDano(valor, pos)
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.Transparency = 1
    p.Size = Vector3.new(0.2, 0.2, 0.2)
    p.Position = pos + Vector3.new(math.random(-10, 10) / 10, 0, math.random(-10, 10) / 10)
    p.Parent = workspace
    
    local b = Instance.new("BillboardGui")
    b.Adornee = p
    b.Size = UDim2.new(0, 80, 0, 30)
    b.AlwaysOnTop = true
    b.Parent = p
    
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, 0, 1, 0)
    l.BackgroundTransparency = 1
    l.Text = tostring(math.floor(valor * 10 + 0.5) / 10)
    l.TextColor3 = COR_DANO
    l.TextStrokeTransparency = 0.3
    l.Font = Enum.Font.GothamBlack
    l.TextSize = 24
    l.Parent = b
    
    local info = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(p, info, {Position = p.Position + Vector3.new(0, 3, 0)}):Play()
    TweenService:Create(l, TweenInfo.new(0.8), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
    
    Debris:AddItem(p, 1)
end
 
evento.OnClientEvent:Connect(function(tipo, a, b)
    if tipo == "dano" then
        mostrarDano(a, b)
    elseif tipo == "item" then
        empilhar(a, b, function(t) return "+" .. t .. " " .. a end, COR_ITEM)
        elseif tipo == "cheia" then
            empilhar("__cheia", 0, function() return "Mochila cheia!" end, COR_AVISO)
            end
            end)
                -- ===== INDICADOR DE OURO =====
                local stats = player:WaitForChild("leaderstats")
                local ouro = stats:WaitForChild("Ouro")
                local ouroAnterior = ouro.Value
                
                ouro.Changed:Connect(function(novo)
                    local diferenca = novo - ouroAnterior
                    ouroAnterior = novo
                    
                    if diferenca > 0 then
                        empilhar("__ouro_ganho", diferenca, function(t)
                            return "Você ganhou " .. t .. " de ouro"
                        end, COR_GANHO)
                    elseif diferenca < 0 then
                        empilhar("__ouro_perda", -diferenca, function(t)
                            return "Você perdeu " .. t .. " de ouro"
                        end, COR_PERDA)
                    end
                end)
                
                -- ===== INDICADOR DE XP + SOM DE NÍVEL =====
                player:WaitForChild("DadosCarregados", 20)
                local nivel = stats:WaitForChild("Nivel")
                local xp = stats:WaitForChild("XP")
                
                local somNivel = Instance.new("Sound")
                somNivel.Name = "SomNivel"
                somNivel.Volume = VOLUME_NIVEL
                somNivel.Parent = gui
                
                if SOM_NIVEL_ID ~= "" then
                    local id = tostring(SOM_NIVEL_ID)
                    if tonumber(id) then
                        id = "rbxassetid://" .. id
                    end
                    somNivel.SoundId = id
                end
                
                local xpAnterior = xp.Value
                local nivelAnterior = nivel.Value
                
                xp.Changed:Connect(function(novo)
                    local ganho
                    
                    if nivel.Value > nivelAnterior then
                        -- subiu de nível: o XP "virou" o contador
                        ganho = (nivelAnterior * 100 - xpAnterior) + novo
                    else
                        ganho = novo - xpAnterior
                    end
                    
                    xpAnterior = novo
                    
                    if ganho > 0 then
                        empilhar("__xp", ganho, function(t)
                            return "+" .. t .. " XP"
                        end, COR_XP)
                    end
                end)
                
                nivel.Changed:Connect(function(novo)
                    if novo > nivelAnterior then
                        if SOM_NIVEL_ID ~= "" then
                            somNivel:Play()
                        end
                        empilhar("__nivel", 0, function()
                            return "Nível " .. novo .. "!"
                        end, COR_GANHO)
                    end
                    nivelAnterior = novo
                end)
               
]]></ProtectedString>
