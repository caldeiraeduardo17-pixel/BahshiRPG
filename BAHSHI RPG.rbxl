<Item class="Script" referent="RBX66C1625455D04AC580D8103381513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">ArcoServer</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local tool = script.Parent
local remote = tool:WaitForChild("Atirar")

local VERSAO = 5

-- ===== CONFIGURAÇÕES =====
local NOME_FLECHA = "Flecha"       -- nome do modelo em ServerStorage > Projeteis
local NOME_SAIDA = "SaidaFlecha"   -- Attachment ou Part dentro do arco onde a flecha nasce (opcional)
local AVANCO_SAIDA = 0.5           -- quanto a flecha avança à frente do ponto de saída
local INVERTER_FLECHA = false      -- true se a flecha voar com a ponta pra trás
local AJUSTE_MODELO = CFrame.Angles(0, 0, 0) -- ajuste manual extra (normalmente não precisa)
local ITEM_MUNICAO = nil           -- nome do item que gasta 1 por tiro (ex: "Flecha"). nil = infinita

-- direção do tiro
local CONVERGENCIA = 0             -- 0 = reta (paralela à câmera) / 1 = vai exatamente no ponto da mira (sobe em alvos próximos)
local ZONA_RETA_GRAUS = 2          -- câmera até esse ângulo pra cima/baixo: a flecha sai horizontal (0 = desligado)
local DEPURAR = true               -- mostra na tela o ângulo da câmera e da flecha depois de cada tiro (desligue quando acertar)

-- carga (estilo Minecraft)
local TEMPO_CARGA = 1.0            -- segundos segurando pra carga total
local CARGA_MINIMA = 0.15          -- carga mínima pra a flecha sair (0.15 = 15%)
local VELOCIDADE_MIN = 90          -- velocidade da flecha com pouca carga (studs por segundo)
local VELOCIDADE_MAX = 220         -- velocidade da flecha com carga total
local DANO_MIN_PCT = 0.3           -- dano com pouca carga (0.3 = 30% do dano total)

local DANO = 12                    -- dano com carga total
local COOLDOWN = 0.4               -- espera depois de atirar, antes de poder carregar de novo
local COOLDOWN_MINIMO = 0.2
local BONUS_DANO = 0.3             -- +0,3 de dano por nível de Arco
local BONUS_VELOCIDADE = 0.005     -- -0,005s de espera por nível de Arco

local GRAVIDADE = 30               -- quanto a flecha cai (maior = cai mais)
local VIDA_FLECHA = 5              -- segundos no ar antes de sumir
local TEMPO_ESPETADA = 8           -- segundos que a flecha fica espetada no cenário

local SOM_TIRO_ID = ""             -- cole o ID aqui (só o número ou "rbxassetid://...")
local VOLUME_TIRO = 0.8
-- =========================

local somTiro = Instance.new("Sound")
somTiro.Name = "SomTiro"
somTiro.Volume = VOLUME_TIRO
somTiro.RollOffMaxDistance = 80
somTiro.Parent = tool:FindFirstChild("Handle") or tool

if SOM_TIRO_ID ~= "" then
    local id = tostring(SOM_TIRO_ID)
    if tonumber(id) then
        id = "rbxassetid://" .. id
    end
    somTiro.SoundId = id
end

local ultimo = 0
local carregando = false
local inicioCarga = 0
local avisouEixo = false

local function status(jogador)
    local h = jogador:FindFirstChild("Habilidades")
    local a = h and h:FindFirstChild("Arco")
    local n = (a and a.Nivel.Value or 1) - 1
    local dano = DANO + n * BONUS_DANO
    local cd = math.max(COOLDOWN_MINIMO, COOLDOWN - n * BONUS_VELOCIDADE)
    return dano, cd
end

local function temMunicao(jogador)
    if not ITEM_MUNICAO then return true end
    local inv = jogador:FindFirstChild("Inventario")
    local item = inv and inv:FindFirstChild(ITEM_MUNICAO)
    return item ~= nil and item.Value >= 1
end

local function posicionar(obj, cf)
    if obj:IsA("Model") then
        obj:PivotTo(cf)
    else
        obj.CFrame = cf
    end
end

local function preparar(obj)
    local partes = obj:GetDescendants()
    table.insert(partes, obj)
    for _, p in ipairs(partes) do
        if p:IsA("BasePart") then
            p.Anchored = true
            p.CanCollide = false
            p.CanQuery = false
            p.CanTouch = false
        end
    end
end

-- De onde a flecha sai: marca SaidaFlecha, senão o Handle do arco, senão o corpo
local function pontoDeSaida(hrp)
    local marca = tool:FindFirstChild(NOME_SAIDA, true)
    if marca then
        if marca:IsA("Attachment") then
            return marca.WorldPosition
        elseif marca:IsA("BasePart") then
            return marca.Position
        end
    end
    
    local handle = tool:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then
        return handle.Position
    end
    
    return hrp.Position + Vector3.new(0, 1.2, 0)
end

-- Zona reta: até zonaGraus de inclinação (pra cima ou pra baixo) vira horizontal.
-- Acima disso, a flecha segue a câmera descontando a zona.
local function aplicarZonaReta(dir, zonaGraus)
    if zonaGraus <= 0 then
        return dir
    end
    
    local horizontal = Vector3.new(dir.X, 0, dir.Z)
    if horizontal.Magnitude < 0.001 then
        return dir
    end
    
    local inclinacao = math.asin(math.clamp(dir.Y, -1, 1))
    local zona = math.rad(zonaGraus)
    local nova = math.sign(inclinacao) * math.max(0, math.abs(inclinacao) - zona)
    
    return (horizontal.Unit * math.cos(nova) + Vector3.new(0, math.sin(nova), 0)).Unit
end

-- Descobre qual lado da flecha é o comprimento e devolve a rotação que
-- faz a ponta apontar pra frente do voo (o lado -Z do CFrame)
local function calcularAjuste(modelo)
    local pivo = modelo:GetPivot()
    local tam
    local centro
    
    if modelo:IsA("Model") then
        local cf, s = modelo:GetBoundingBox()
        tam = s
        centro = cf.Position
    else
        tam = modelo.Size
        centro = modelo.Position
    end
    
    -- eixo mais comprido = comprimento da flecha
    local eixo = "z"
    local maior = tam.Z
    if tam.X > maior then
        eixo, maior = "x", tam.X
    end
    if tam.Y > maior then
        eixo, maior = "y", tam.Y
    end
    
    -- lado da ponta: padrão = +X, +Y ou -Z
    local lado = (eixo == "z") and -1 or 1
    
    -- se existir uma peça chamada Ponta (ou Tip), usa ela pra descobrir o lado
    local ponta = modelo:FindFirstChild("Ponta", true) or modelo:FindFirstChild("Tip", true)
    if ponta and ponta:IsA("BasePart") then
        local rel = pivo:PointToObjectSpace(ponta.Position) - pivo:PointToObjectSpace(centro)
        local v = (eixo == "x" and rel.X) or (eixo == "y" and rel.Y) or rel.Z
        lado = (v >= 0) and 1 or -1
    end
    
    if INVERTER_FLECHA then
        lado = -lado
    end
    
    if not avisouEixo then
        avisouEixo = true
        print("ArcoServer: comprimento da flecha no eixo " .. eixo .. ", ponta no lado " .. lado)
    end
    
    if eixo == "z" then
        return (lado == -1) and CFrame.new() or CFrame.Angles(0, math.rad(180), 0)
    elseif eixo == "x" then
        return CFrame.Angles(0, math.rad(lado == 1 and 90 or -90), 0)
    else
        return CFrame.Angles(math.rad(lado == 1 and -90 or 90), 0, 0)
    end
end

local function lancar(jogador, char, modelo, origem, direcao, velocidade, dano)
    local ajuste = calcularAjuste(modelo) * AJUSTE_MODELO
    
    local flecha = modelo:Clone()
    preparar(flecha)
    
    local pos = origem
    local vel = direcao * velocidade
    posicionar(flecha, CFrame.lookAt(pos, pos + vel) * ajuste)
    flecha.Parent = workspace
    
    -- ignora quem atirou e os outros jogadores
    local filtro = {char, flecha}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            table.insert(filtro, p.Character)
        end
    end
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.RespectCanCollide = true
    params.FilterDescendantsInstances = filtro
    
    task.spawn(function()
        local tempo = 0
        
        while flecha.Parent and tempo < VIDA_FLECHA do
            local dt = RunService.Heartbeat:Wait()
            tempo += dt
            
            -- sai reta e a gravidade vai puxando a flecha pra baixo
            vel += Vector3.new(0, -GRAVIDADE, 0) * dt
            local passo = vel * dt
            local res = workspace:Raycast(pos, passo, params)
            
            local atravessa = false
            if res then
                local alvoModelo = res.Instance:FindFirstAncestorOfClass("Model")
                local hum = alvoModelo and alvoModelo:FindFirstChildOfClass("Humanoid")
                
                if hum and (Players:GetPlayerFromCharacter(alvoModelo) or string.find(alvoModelo.Name, "^Loja_")) then
                    -- jogadores e lojistas não levam flechada: atravessa
                    table.insert(filtro, alvoModelo)
                    params.FilterDescendantsInstances = filtro
                    atravessa = true
                else
                    posicionar(flecha, CFrame.lookAt(res.Position, res.Position + vel) * ajuste)
                    
                    if hum and hum.Health > 0 then
                        hum:TakeDamage(dano)
                        
                        local indicador = ReplicatedStorage:FindFirstChild("Indicador")
                        local raiz = alvoModelo:FindFirstChild("HumanoidRootPart")
                        if indicador and raiz then
                            indicador:FireClient(jogador, "dano", dano, raiz.Position + Vector3.new(0, 3, 0))
                        end
                        
                        local treino = ServerStorage:FindFirstChild("TreinarHabilidade")
                        if treino then
                            treino:Fire(jogador, "Arco", 1)
                        end
                        
                        flecha:Destroy()
                    else
                        Debris:AddItem(flecha, TEMPO_ESPETADA)
                    end
                    return
                end
            end
            
            if not res or atravessa then
                pos += passo
                posicionar(flecha, CFrame.lookAt(pos, pos + vel) * ajuste)
            end
        end
        
        if flecha.Parent then
            flecha:Destroy()
        end
    end)
end

remote.OnServerEvent:Connect(function(jogador, acao, alvo, dirCamera)
    local char = jogador.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 or tool.Parent ~= char then
        carregando = false
        return
    end
    
    local dano, cd = status(jogador)
    
    -- começou a segurar
    if acao == "carregar" then
        if carregando then return end
        if tick() - ultimo < cd - 0.05 then return end
        
        if not temMunicao(jogador) then
            remote:FireClient(jogador, "aviso", "Sem flechas")
            return
        end
        
        carregando = true
        inicioCarga = tick()
        remote:FireClient(jogador, "carga", TEMPO_CARGA)
        
        -- desistiu
    elseif acao == "cancelar" then
        carregando = false
        
        -- soltou: atira com a carga que o SERVIDOR mediu
    elseif acao == "soltar" then
        if not carregando then return end
        carregando = false
        
        local carga = math.clamp((tick() - inicioCarga) / TEMPO_CARGA, 0, 1)
        if carga < CARGA_MINIMA then
            remote:FireClient(jogador, "cancelado")
            return
        end
        
        if typeof(alvo) ~= "Vector3" or alvo ~= alvo then return end
        if typeof(dirCamera) ~= "Vector3" or dirCamera ~= dirCamera or dirCamera.Magnitude < 0.5 then return end
        
        local pasta = ServerStorage:FindFirstChild("Projeteis")
        local modelo = pasta and pasta:FindFirstChild(NOME_FLECHA)
        if not modelo then
            warn("ArcoServer: crie ServerStorage > Projeteis > " .. NOME_FLECHA)
            remote:FireClient(jogador, "cancelado")
            return
        end
        
        -- gasta a flecha só na hora de atirar
        if ITEM_MUNICAO then
            local tirar = ServerStorage:FindFirstChild("TirarItem")
            if not tirar or tirar:Invoke(jogador, ITEM_MUNICAO, 1) < 1 then
                remote:FireClient(jogador, "aviso", "Sem flechas")
                return
            end
        end
        
        -- a flecha sai do arco
        local origem = pontoDeSaida(hrp)
        local delta = alvo - origem
        if delta.Magnitude > 2000 then return end
        
        -- direção reta: paralela à câmera, com a zona reta aplicada
        local dirCam = dirCamera.Unit
        local dirReta = aplicarZonaReta(dirCam, ZONA_RETA_GRAUS)
        
        -- direção até o ponto da mira (só entra se CONVERGENCIA > 0)
        local dirAlvo = (delta.Magnitude < 2) and dirReta or delta.Unit
        
        local direcao = dirReta:Lerp(dirAlvo, math.clamp(CONVERGENCIA, 0, 1))
        if direcao.Magnitude < 0.01 then
            direcao = dirReta
        else
            direcao = direcao.Unit
        end
        
        local inicio = origem + direcao * AVANCO_SAIDA
        
        -- a carga define a velocidade e o dano
        local velocidade = VELOCIDADE_MIN + (VELOCIDADE_MAX - VELOCIDADE_MIN) * carga
        local danoFinal = dano * (DANO_MIN_PCT + (1 - DANO_MIN_PCT) * carga)
        
        ultimo = tick()
        
        if SOM_TIRO_ID ~= "" then
            somTiro.PlaybackSpeed = 0.8 + carga * 0.4
            somTiro:Play()
        end
        
        lancar(jogador, char, modelo, inicio, direcao, velocidade, danoFinal)
        
        if DEPURAR then
            local anguloCamera = math.deg(math.asin(math.clamp(dirCam.Y, -1, 1)))
            local anguloFlecha = math.deg(math.asin(math.clamp(direcao.Y, -1, 1)))
            remote:FireClient(jogador, "recarga", cd, anguloCamera, anguloFlecha, VERSAO)
        else
            remote:FireClient(jogador, "recarga", cd)
        end
    end
end)

tool.Unequipped:Connect(function()
    carregando = false
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8033820041fa</UniqueId>
</Properties>
</Item>
<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454103383AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">ArcoClient</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
 
local tool = script.Parent
local remote = tool:WaitForChild("Atirar")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
 
-- ===== CONFIGURAÇÕES =====
local DESLOCAMENTO = Vector3.new(1.75, 0.25, 0) -- câmera por cima do ombro (-1.75 = ombro esquerdo)
local ALCANCE_MIRA = 400                        -- distância máxima da mira
local TEXTO_BOTAO = "Atirar"
local COOLDOWN_PADRAO = 0.4                     -- usado só até o servidor responder
local TECLA_LIBERAR_MOUSE = Enum.KeyCode.LeftAlt -- no PC, segure pra soltar o mouse (abrir inventário, loja...)
local CORRECAO_MIRA = Vector2.new(-1, 0)          -- correção manual em pixels: X negativo desloca a pontaria pra esquerda, positivo pra direita
local COR_CARGA = Color3.fromRGB(230, 190, 60)
local COR_CARGA_TOTAL = Color3.fromRGB(110, 220, 110)
-- =========================
 
-- ===== ANIMAÇÃO DE ATAQUE =====
local ANIM_ID = ""          -- OPÇÃO 1: ID da animação publicada (só o número ou "rbxassetid://...")
local ANIM_KEYFRAME = ""    -- OPÇÃO 2: nome de um KeyframeSequence dentro da Tool (só no teste do Studio)
local ANIM_VELOCIDADE = 1   -- 1 = normal, 2 = o dobro da velocidade
 
local Animacao = nil
task.spawn(function()
    local modulo = game:GetService("ReplicatedStorage"):WaitForChild("Animacao", 10)
    if not modulo then
        warn("Animação: não achei o ModuleScript 'Animacao' em ReplicatedStorage (confira o nome)")
        return
    end
    local ok, resultado = pcall(require, modulo)
    if ok then
        Animacao = resultado
        print("Animação: módulo carregado")
    else
        warn("Animação: erro dentro do ModuleScript Animacao: " .. tostring(resultado))
    end
end)
 
local function tocarAnimacao()
    if not Animacao then return end
    
    local ok, erro = pcall(function()
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        
        Animacao.tocar(hum, {
        id = ANIM_ID,
        keyframe = (ANIM_KEYFRAME ~= "") and tool:FindFirstChild(ANIM_KEYFRAME) or nil,
        velocidade = ANIM_VELOCIDADE,
        })
    end)
    if not ok then
        warn("Animação: " .. tostring(erro))
    end
end
-- ==============================
 
local gui = nil
local miraFrame = nil
local fundoBarra = nil
local barra = nil
local textoAviso = nil
local conexao = nil
local guardado = {pronto = false, autoRotate = true, offset = Vector3.zero}
 
local proximo = 0
local carregando = false
local inicioLocal = 0
local tempoCarga = 1
local sessaoAviso = 0
 
local desligarMira -- definida mais abaixo
 
local function liberarMouse()
    if not UserInputService.TouchEnabled then
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end
 
local function esconderBarra()
    if fundoBarra then
        fundoBarra.Visible = false
    end
end
 
-- devolve: o ponto do mundo embaixo da mira e a direção da linha de visão da câmera
local function pontoDeMira()
    local x, y
    if miraFrame then
        local c = miraFrame.AbsolutePosition + miraFrame.AbsoluteSize / 2
        x, y = c.X, c.Y
    else
        local centro = camera.ViewportSize / 2
        x, y = centro.X, centro.Y
    end
    
    x += CORRECAO_MIRA.X
    y += CORRECAO_MIRA.Y
    
    local raio = camera:ViewportPointToRay(x, y)
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.RespectCanCollide = true
    params.FilterDescendantsInstances = {player.Character}
    
    local res = workspace:Raycast(raio.Origin, raio.Direction * ALCANCE_MIRA, params)
    local ponto
    if res then
        ponto = res.Position
    else
        ponto = raio.Origin + raio.Direction * ALCANCE_MIRA
    end
    
    return ponto, raio.Direction.Unit
end
 
local function mostrarAviso(texto, cor, tempo)
    if not textoAviso then return end
    sessaoAviso += 1
    local meu = sessaoAviso
    textoAviso.Text = texto
    textoAviso.TextColor3 = cor or Color3.fromRGB(255, 120, 120)
    task.delay(tempo or 1.5, function()
        if meu == sessaoAviso and textoAviso then
            textoAviso.Text = ""
        end
    end)
end
 
-- ===== CARGA: segurar e soltar =====
local function comecarCarga()
    if not gui or carregando then return end
    if tick() < proximo then return end
    
    carregando = true
    inicioLocal = tick()
    remote:FireServer("carregar")
end
 
local function soltarCarga()
    if not carregando then return end
    carregando = false
    esconderBarra()
    
    local ponto, direcao = pontoDeMira()
    remote:FireServer("soltar", ponto, direcao)
    proximo = tick() + COOLDOWN_PADRAO -- provisório, o servidor confirma depois
    tocarAnimacao()
end
 
local function criarGui()
    gui = Instance.new("ScreenGui")
    gui.Name = "ArcoUI"
    gui.IgnoreGuiInset = true -- a mira fica exatamente no centro da tela
    pcall(function()
        -- ocupa a tela inteira (sem margens de notch/bordas), pra a mira bater com a pontaria
        gui.ScreenInsets = Enum.ScreenInsets.None
    end)
    gui.DisplayOrder = 25
    gui.Parent = player:WaitForChild("PlayerGui")
    
    -- mira
    local mira = Instance.new("Frame")
    mira.AnchorPoint = Vector2.new(0.5, 0.5)
    mira.Position = UDim2.new(0.5, 0, 0.5, 0)
    mira.Size = UDim2.new(0, 40, 0, 40)
    mira.BackgroundTransparency = 1
    mira.Parent = gui
    miraFrame = mira
    
    local function traco(pos, tam)
        local f = Instance.new("Frame")
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = pos
        f.Size = tam
        f.BackgroundColor3 = Color3.new(1, 1, 1)
        f.BorderSizePixel = 1
        f.BorderColor3 = Color3.new(0, 0, 0)
        f.Parent = mira
    end
    
    traco(UDim2.new(0.5, 0, 0.5, 0), UDim2.new(0, 4, 0, 4))   -- ponto
    traco(UDim2.new(0.5, 0, 0, 3), UDim2.new(0, 2, 0, 10))    -- cima
    traco(UDim2.new(0.5, 0, 1, -3), UDim2.new(0, 2, 0, 10))   -- baixo
    traco(UDim2.new(0, 3, 0.5, 0), UDim2.new(0, 10, 0, 2))    -- esquerda
    traco(UDim2.new(1, -3, 0.5, 0), UDim2.new(0, 10, 0, 2))   -- direita
    
    -- barra de carga
    fundoBarra = Instance.new("Frame")
    fundoBarra.AnchorPoint = Vector2.new(0.5, 0)
    fundoBarra.Position = UDim2.new(0.5, 0, 0.5, 34)
    fundoBarra.Size = UDim2.new(0, 90, 0, 8)
    fundoBarra.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    fundoBarra.BorderSizePixel = 0
    fundoBarra.Visible = false
    fundoBarra.Parent = gui
    
    barra = Instance.new("Frame")
    barra.Size = UDim2.new(0, 0, 1, 0)
    barra.BackgroundColor3 = COR_CARGA
    barra.BorderSizePixel = 0
    barra.Parent = fundoBarra
    
    -- aviso (ex: sem flechas) e texto de depuração
    textoAviso = Instance.new("TextLabel")
    textoAviso.AnchorPoint = Vector2.new(0.5, 1)
    textoAviso.Position = UDim2.new(0.5, 0, 0.5, -34)
    textoAviso.Size = UDim2.new(0, 320, 0, 22)
    textoAviso.BackgroundTransparency = 1
    textoAviso.Text = ""
    textoAviso.TextColor3 = Color3.fromRGB(255, 120, 120)
    textoAviso.TextStrokeTransparency = 0.4
    textoAviso.Font = Enum.Font.GothamBold
    textoAviso.TextSize = 16
    textoAviso.Parent = gui
    
    -- botão de atirar: segure pra carregar, solte pra atirar
    local botao = Instance.new("TextButton")
    botao.AnchorPoint = Vector2.new(1, 1)
    botao.Position = UDim2.new(1, -150, 1, -60) -- ao lado do botão de pulo
    botao.Size = UDim2.new(0, 90, 0, 90)
    botao.BackgroundColor3 = Color3.fromRGB(150, 60, 40)
    botao.BorderSizePixel = 0
    botao.Text = TEXTO_BOTAO
    botao.TextColor3 = Color3.new(1, 1, 1)
    botao.Font = Enum.Font.GothamBold
    botao.TextSize = 18
    botao.AutoButtonColor = false
    botao.Parent = gui
    
    local canto = Instance.new("UICorner")
    canto.CornerRadius = UDim.new(1, 0)
    canto.Parent = botao
    
    botao.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            
            comecarCarga()
            
            -- solta quando esse mesmo toque/clique terminar, mesmo fora do botão
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    conn:Disconnect()
                    soltarCarga()
                end
            end)
        end
    end)
end
 
local function ligarMira()
    if conexao then return end
    
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    -- guarda o estado de antes (pra respeitar o botão de shift lock)
    guardado.pronto = true
    guardado.autoRotate = hum.AutoRotate
    guardado.offset = hum.CameraOffset
    
    hum.AutoRotate = false
    hum.CameraOffset = DESLOCAMENTO
    criarGui()
    
    conexao = RunService.RenderStepped:Connect(function()
        -- barra de carga enchendo
        if carregando and barra and fundoBarra then
            local p = math.clamp((tick() - inicioLocal) / tempoCarga, 0, 1)
            fundoBarra.Visible = true
            barra.Size = UDim2.new(p, 0, 1, 0)
            barra.BackgroundColor3 = (p >= 1) and COR_CARGA_TOTAL or COR_CARGA
        end
        
        local c = player.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        local raiz = c and c:FindFirstChild("HumanoidRootPart")
        if not h or not raiz then return end
        
        -- morreu: desliga a mira e solta o mouse (pra poder clicar em Renascer)
        if h.Health <= 0 then
            desligarMira()
            return
        end
        
        -- deitado ou preso: solta o mouse (pra poder clicar em Levantar)
        if h.PlatformStand or raiz.Anchored then
            liberarMouse()
            return
        end
        
        -- o personagem olha pra onde a câmera aponta
        local olhar = camera.CFrame.LookVector
        local plano = Vector3.new(olhar.X, 0, olhar.Z)
        if plano.Magnitude > 0.01 then
            raiz.CFrame = CFrame.new(raiz.Position, raiz.Position + plano)
        end
        
        -- no PC: mouse preso no centro, a não ser que você segure a tecla de liberar
        if not UserInputService.TouchEnabled then
            if UserInputService:IsKeyDown(TECLA_LIBERAR_MOUSE) then
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            else
                UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            end
        end
    end)
end
 
desligarMira = function()
    if conexao then
        conexao:Disconnect()
        conexao = nil
    end
    
    -- se estava carregando, avisa o servidor que desistiu
    if carregando then
        carregando = false
        remote:FireServer("cancelar")
    end
    
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and guardado.pronto then
        hum.AutoRotate = guardado.autoRotate
        hum.CameraOffset = guardado.offset
    end
    guardado.pronto = false
    
    liberarMouse()
    
    if gui then
        gui:Destroy()
        gui = nil
    end
    miraFrame = nil
    fundoBarra = nil
    barra = nil
    textoAviso = nil
end
 
remote.OnClientEvent:Connect(function(tipo, valor, anguloCamera, anguloFlecha, versao)
    if tipo == "carga" then
        -- o servidor confirmou e disse quanto tempo leva a carga total
        tempoCarga = math.max(0.1, valor)
        
    elseif tipo == "recarga" then
        proximo = tick() + valor
        
        -- depuração: ângulo da câmera e da flecha (vem do servidor)
        if anguloCamera and anguloFlecha then
            mostrarAviso(
            string.format("v%d  câmera %+.1f°  flecha %+.1f°", versao or 0, anguloCamera, anguloFlecha),
            Color3.fromRGB(120, 200, 255),
            3
            )
        end
        
    elseif tipo == "cancelado" then
        carregando = false
        proximo = 0
        esconderBarra()
        
    elseif tipo == "aviso" then
        carregando = false
        proximo = 0
        esconderBarra()
        mostrarAviso(valor)
    end
end)
 
tool.Equipped:Connect(ligarMira)
tool.Unequipped:Connect(function()
    desligarMira()
end)
 
tool.AncestryChanged:Connect(function(_, pai)
    if not pai then
        desligarMira()
    end
end)
 
-- no PC: segure o botão do mouse pra carregar e solte pra atirar
-- (no celular só o botão da tela)
tool.Activated:Connect(function()
    if not UserInputService.TouchEnabled then
        comecarCarga()
    end
end)
 
tool.Deactivated:Connect(function()
    if not UserInputService.TouchEnabled then
        soltarCarga()
    end
end)

]]></ProtectedString>
