<ProtectedString name="Source"><![CDATA[local Lojas = {}

-- A chave é o que vem depois de "Loja_" no nome do NPC.
-- NPC "Loja_Ferreiro" usa Lojas.Ferreiro

Lojas.Ferreiro = {
nome = "Ferreiro",
-- o que o jogador COMPRA aqui
vende = {
{item = "Tocha", preco = 30},
{item = "Bandagem", preco = 15},
{item = "Espada De Ferro", preco = 180},
{item = "Adaga", preco = 90},
{item = "Arco", preco = 30},
},
-- o que o jogador VENDE aqui (preço por unidade)
compra = {
{item = "Pele de Lobo", preco = 5},
},
}

Lojas.Curandeiro = {
nome = "Curandeiro",
vende = {
{item = "Bandagem", preco = 12},
},
compra = {},
}

return Lojas

]]></ProtectedString>
