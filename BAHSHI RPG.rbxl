<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">InventarioScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

local hud = script.Parent
local painel = hud:WaitForChild("PainelInventario")
local lista = painel:WaitForChild("ListaItens")
local modelo = lista:WaitForChild("ModeloItem")
local capacidade = painel:WaitForChild("Capacidade")
local botaoMelhorar = painel:WaitForChild("BotaoMelhorar")
local botao = hud:WaitForChild("BotaoInventario")
local melhorar = ReplicatedStorage:WaitForChild("MelhorarMochila")
local equiparRemote = ReplicatedStorage:WaitForChild("EquiparSlot")
local equipaveis = ReplicatedStorage:WaitForChild("EquipaveisInfo")
local tamanhoPilha = ReplicatedStorage:WaitForChild("TamanhoPilha")

local inv = player:WaitForChild("Inventario")
local mochila = player:WaitForChild("Mochila")
local slotsPasta = player:WaitForChild("Slots")

local NUM_SLOTS = 4
local COR_NORMAL = Color3.fromRGB(65, 54, 43)
local COR_ATIVO = Color3.fromRGB(70, 150, 70)

modelo.Visible = false

-- ===== SELETOR DE SLOT =====
local seletor = Instance.new("Frame")
seletor.Name = "SeletorSlot"
seletor.AnchorPoint = Vector2.new(0.5, 0.5)
seletor.Position = UDim2.new(0.5, 0, 0.5, 0)
seletor.Size = UDim2.new(0, 320, 0, 170)
seletor.BackgroundColor3 = Color3.fromRGB(40, 33, 26)
seletor.BorderSizePixel = 0
seletor.Visible = false
seletor.ZIndex = 50
seletor.Parent = hud

local tituloSel = Instance.new("TextLabel")
tituloSel.Position = UDim2.new(0, 8, 0, 8)
tituloSel.Size = UDim2.new(1, -16, 0, 24)
tituloSel.BackgroundTransparency = 1
tituloSel.TextColor3 = Color3.fromRGB(255, 220, 130)
tituloSel.Font = Enum.Font.GothamBold
tituloSel.TextSize = 16
tituloSel.ZIndex = 51
tituloSel.Parent = seletor
tituloSel.AutoLocalize = true

local fila = Instance.new("Frame")
fila.Position = UDim2.new(0, 10, 0, 40)
fila.Size = UDim2.new(1, -20, 0, 64)
fila.BackgroundTransparency = 1
fila.ZIndex = 51
fila.Parent = seletor

local filaLayout = Instance.new("UIListLayout")
filaLayout.FillDirection = Enum.FillDirection.Horizontal
filaLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
filaLayout.SortOrder = Enum.SortOrder.LayoutOrder
filaLayout.Padding = UDim.new(0, 6)
filaLayout.Parent = fila

local botoesSlot = {}
local itemSelecionado = nil

local function fecharSeletor()
    itemSelecionado = nil
    seletor.Visible = false
end

for i = 1, NUM_SLOTS do
    local b = Instance.new("TextButton")
    b.AutoLocalize = true
    b.Size = UDim2.new(0, 70, 0, 64)
    b.LayoutOrder = i
    b.BackgroundColor3 = COR_NORMAL
    b.BorderSizePixel = 0
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 12
    b.TextWrapped = true
    b.ZIndex = 52
    b.Parent = fila
    
    b.Activated:Connect(function()
        if itemSelecionado then
            equiparRemote:FireServer(i, itemSelecionado)
        end
        fecharSeletor()
    end)
    
    botoesSlot[i] = b
end

local botaoTirar = Instance.new("TextButton")
botaoTirar.AutoLocalize = true
botaoTirar.Position = UDim2.new(0, 10, 1, -44)
botaoTirar.Size = UDim2.new(0, 140, 0, 34)
botaoTirar.BackgroundColor3 = Color3.fromRGB(120, 60, 50)
botaoTirar.BorderSizePixel = 0
botaoTirar.Text = "Tirar da hotbar"
botaoTirar.TextColor3 = Color3.new(1, 1, 1)
botaoTirar.Font = Enum.Font.GothamBold
botaoTirar.TextSize = 14
botaoTirar.ZIndex = 52
botaoTirar.Parent = seletor

local botaoCancelar = Instance.new("TextButton")
botaoCancelar.AutoLocalize = true
botaoCancelar.AnchorPoint = Vector2.new(1, 0)
botaoCancelar.Position = UDim2.new(1, -10, 1, -44)
botaoCancelar.Size = UDim2.new(0, 140, 0, 34)
botaoCancelar.BackgroundColor3 = COR_NORMAL
botaoCancelar.BorderSizePixel = 0
botaoCancelar.Text = "Cancelar"
botaoCancelar.TextColor3 = Color3.new(1, 1, 1)
botaoCancelar.Font = Enum.Font.GothamBold
botaoCancelar.TextSize = 14
botaoCancelar.ZIndex = 52
botaoCancelar.Parent = seletor

local function slotDoItem(nome)
    for i = 1, NUM_SLOTS do
        local v = slotsPasta:FindFirstChild(tostring(i))
        if v and v.Value == nome then
            return i
        end
    end
    return nil
end

local function atualizarSeletor()
    if not itemSelecionado then return end
    
    tituloSel.Text = "Equipar " .. itemSelecionado .. " em:"
    for i = 1, NUM_SLOTS do
        local v = slotsPasta:FindFirstChild(tostring(i))
        local nomeSlot = v and v.Value or ""
        local b = botoesSlot[i]
        b.Text = i .. "\n" .. (nomeSlot ~= "" and nomeSlot or "vazio")
        b.BackgroundColor3 = (nomeSlot == itemSelecionado) and COR_ATIVO or COR_NORMAL
    end
    botaoTirar.Visible = slotDoItem(itemSelecionado) ~= nil
end

local function abrirSeletor(nome)
    itemSelecionado = nome
    seletor.Visible = true
    atualizarSeletor()
end

botaoTirar.Activated:Connect(function()
    local j = itemSelecionado and slotDoItem(itemSelecionado)
    if j then
        equiparRemote:FireServer(j, "")
    end
    fecharSeletor()
end)

botaoCancelar.Activated:Connect(fecharSeletor)

-- ===== LINHAS DO INVENTÁRIO =====
local function tornarClicavel(linha, nome, mostrarTag)
    if not equipaveis:FindFirstChild(nome) then return end -- só itens equipáveis
        
        local b = Instance.new("TextButton")
        b.AutoLocalize = true
        b.Name = "BotaoEquipar"
        b.Size = UDim2.new(1, 0, 1, 0)
        b.BackgroundTransparency = 1
        b.Text = ""
        b.ZIndex = 20
        b.Parent = linha
        
        b.Activated:Connect(function()
            abrirSeletor(nome)
        end)
        
        -- mostra em qual slot o item está
        local noSlot = slotDoItem(nome)
        if noSlot and mostrarTag then
            local tag = Instance.new("TextLabel")
            tag.AutoLocalize = true
            tag.Name = "TagSlot"
            tag.AnchorPoint = Vector2.new(1, 0)
            tag.Position = UDim2.new(1, -4, -2, 2)
            tag.Size = UDim2.new(0, 70, 0, 16)
            tag.BackgroundTransparency = 1
            tag.Text = "Slot " .. noSlot
            tag.TextColor3 = Color3.fromRGB(120, 220, 120)
            tag.Font = Enum.Font.GothamBold
            tag.TextSize = 4
            tag.TextXAlignment = Enum.TextXAlignment.Right
            tag.ZIndex = 21
            tag.Parent = linha
        end
    end
    
    botao.Activated:Connect(function()
        painel.Visible = not painel.Visible
    end)
    
    painel:GetPropertyChangedSignal("Visible"):Connect(function()
        if not painel.Visible then
            fecharSeletor()
        end
    end)
    
    botaoMelhorar.Activated:Connect(function()
        melhorar:FireServer()
    end)
    
    local function redesenhar()
        for _, f in ipairs(lista:GetChildren()) do
            if f:IsA("GuiObject") and f ~= modelo then
                f:Destroy()
            end
        end
        
        for _, item in ipairs(inv:GetChildren()) do
            -- equipamento não empilha (1 por linha), o resto usa o tamanho da pilha
            local infoItem = equipaveis:FindFirstChild(item.Name)
            local pilha = (infoItem and infoItem.Value ~= "empilha") and 1 or math.max(1, tamanhoPilha.Value)
            local restante = item.Value
            local primeira = true
            
            while restante > 0 do
                local qtd = math.min(pilha, restante)
                restante -= qtd
                
                local linha = modelo:Clone()
                linha.Name = item.Name
                linha.Visible = true
                linha:WaitForChild("Nome").Text = item.Name
                linha:WaitForChild("Quantidade").Text = "x" .. qtd
                linha.Parent = lista
                tornarClicavel(linha, item.Name, primeira)
                primeira = false
            end
        end
        
        capacidade.Text = "Mochila: " .. mochila.SlotsUsados.Value .. " / " .. mochila.SlotsTotal.Value .. " slots"
        
        if mochila.Custo.Value == 0 then
            botaoMelhorar.Text = "Mochila no máximo"
        else
            botaoMelhorar.Text = "Melhorar mochila (" .. mochila.Custo.Value .. " ouro)"
        end
        
        atualizarSeletor()
    end
    
    local function ligarItem(item)
        item.Changed:Connect(redesenhar)
        redesenhar()
    end
    
    for _, item in ipairs(inv:GetChildren()) do
        ligarItem(item)
    end
    inv.ChildAdded:Connect(ligarItem)
    inv.ChildRemoved:Connect(redesenhar)
    
    for _, v in ipairs(mochila:GetChildren()) do
        v.Changed:Connect(redesenhar)
    end
    
    for _, v in ipairs(slotsPasta:GetChildren()) do
        v.Changed:Connect(redesenhar)
    end
    
    redesenhar()
   
]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940321200437f</UniqueId>
