<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local tool = script.Parent
local remote = tool:WaitForChild("Atacar")
local adagaEsq = tool:WaitForChild("HandleEsquerda")

-- ===== CONFIGURAÇÕES =====
local HABILIDADE = "Espada"        -- habilidade que treina (veja a dica da habilidade "Adaga")
local DANO = 6
local COOLDOWN = 0.5               -- segundos entre golpes
local COOLDOWN_MINIMO = 0.25
local ALCANCE = 5.5                -- studs
local BONUS_DANO = 0.3             -- +0,3 de dano por nível da habilidade
local BONUS_VELOCIDADE = 0.01      -- -0,01s de recarga por nível da habilidade

local TEMPO_RESET_COMBO = 1.2      -- sem atacar por esse tempo: recomeça pela direita
local BONUS_COMBO = 0              -- 0.1 = +10% de dano por golpe seguido (0 = desligado)
local COMBO_MAXIMO = 5             -- limite do bônus de combo

local AJUSTE_ESQUERDA = CFrame.new() -- ajuste da adaga esquerda na mão (veja as dicas)

local SOM_ATAQUE_ID = "127974006064105"           -- cole o ID aqui (só o número ou "rbxassetid://...")
local VOLUME_ATAQUE = 0.6
-- =========================

local somAtaque = Instance.new("Sound")
somAtaque.Name = "SomAtaque"
somAtaque.Volume = VOLUME_ATAQUE
somAtaque.RollOffMaxDistance = 60
somAtaque.Parent = tool:FindFirstChild("Handle") or tool

if SOM_ATAQUE_ID ~= "" then
    local id = tostring(SOM_ATAQUE_ID)
    if tonumber(id) then
        id = "rbxassetid://" .. id
    end
    somAtaque.SoundId = id
end

-- ===== ADAGA ESQUERDA NA MÃO =====
local solda = nil

local function prenderEsquerda(char)
    local maoEsq = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")
    local maoDir = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
    if not maoEsq then return end
    
    adagaEsq.Anchored = false
    adagaEsq.CanCollide = false
    adagaEsq.Massless = true
    
    -- segura do mesmo jeito que a direita
    local c0, c1
    local grip = maoDir and maoDir:WaitForChild("RightGrip", 1)
    if grip and grip:IsA("JointInstance") then
        c0, c1 = grip.C0, grip.C1
    else
        local att = maoEsq:FindFirstChild("LeftGripAttachment")
        c0 = att and att.CFrame or CFrame.new(0, -1, 0)
        c1 = tool.Grip
    end
    
    if solda then
        solda:Destroy()
    end
    
    solda = Instance.new("Weld")
    solda.Name = "GripEsquerdo"
    solda.Part0 = maoEsq
    solda.Part1 = adagaEsq
    solda.C0 = c0 * AJUSTE_ESQUERDA
    solda.C1 = c1
    solda.Parent = maoEsq
end

-- ===== COMBO E ATAQUE =====
local ultimo = 0
local combo = 0

local function status(jogador)
    local h = jogador:FindFirstChild("Habilidades")
    local e = h and h:FindFirstChild(HABILIDADE)
    local n = (e and e.Nivel.Value or 1) - 1
    local dano = DANO + n * BONUS_DANO
    local cd = math.max(COOLDOWN_MINIMO, COOLDOWN - n * BONUS_VELOCIDADE)
    return dano, cd
end

local function golpear(jogador, char, hrp, dano)
    local params = OverlapParams.new()
    params.FilterDescendantsInstances = {char}
    
    local vistos = {}
    local acertou = false
    local indicador = ReplicatedStorage:FindFirstChild("Indicador")
    
    for _, parte in ipairs(workspace:GetPartBoundsInRadius(hrp.Position, ALCANCE, params)) do
        local modelo = parte:FindFirstAncestorOfClass("Model")
        local alvoHum = modelo and modelo:FindFirstChildOfClass("Humanoid")
        local alvoRaiz = modelo and modelo:FindFirstChild("HumanoidRootPart")
        
        if alvoHum and alvoRaiz and alvoHum.Health > 0
            and not vistos[modelo]
            and not Players:GetPlayerFromCharacter(modelo)
            and not string.find(modelo.Name, "^Loja_") then
            
            vistos[modelo] = true
            local direcao = (alvoRaiz.Position - hrp.Position).Unit
            
            -- só acerta quem está na frente
            if hrp.CFrame.LookVector:Dot(direcao) > 0.2 then
                alvoHum:TakeDamage(dano)
                acertou = true
                
                if indicador then
                    indicador:FireClient(jogador, "dano", dano, alvoRaiz.Position + Vector3.new(0, 3, 0))
                end
            end
        end
    end
    
    if acertou then
        local treino = ServerStorage:FindFirstChild("TreinarHabilidade")
        if treino then
            treino:Fire(jogador, HABILIDADE, 1)
        end
    end
end

remote.OnServerEvent:Connect(function(jogador)
    local char = jogador.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 or tool.Parent ~= char then return end
    
    local dano, cd = status(jogador)
    
    local agora = tick()
    if agora - ultimo < cd - 0.05 then return end
    
    -- sem atacar por um tempo: o combo recomeça
    if agora - ultimo > TEMPO_RESET_COMBO then
        combo = 0
    end
    ultimo = agora
    combo += 1
    
    -- 1 = direita, 2 = esquerda, 1 = direita...
    local mao = (combo % 2 == 1) and 1 or 2
    
    if BONUS_COMBO > 0 then
        dano = dano * (1 + BONUS_COMBO * (math.min(combo, COMBO_MAXIMO) - 1))
    end
    
    if SOM_ATAQUE_ID ~= "" then
        somAtaque.PlaybackSpeed = 0.9 + math.random() * 0.2
        somAtaque:Play()
    end
    
    golpear(jogador, char, hrp, dano)
    remote:FireClient(jogador, "golpe", mao, cd, combo)
end)

tool.Equipped:Connect(function()
    local char = tool.Parent
    if char and char:IsA("Model") then
        task.spawn(prenderEsquerda, char)
    end
end)

tool.Unequipped:Connect(function()
    combo = 0
    if solda then
        solda:Destroy()
        solda = nil
    end
end)

]]></ProtectedString>
