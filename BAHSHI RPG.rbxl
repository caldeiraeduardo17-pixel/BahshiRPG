<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- ===== CONFIGURAÇÕES =====
local DESLOCAMENTO = Vector3.new(1.75, 0.25, 0) -- câmera no ombro (use -1.75 pro ombro esquerdo)
local TEXTO = "Mira"
local COR_LIGADO = Color3.fromRGB(70, 150, 70)
local COR_DESLIGADO = Color3.fromRGB(65, 54, 43)
local TECLA_LIBERAR_MOUSE = Enum.KeyCode.LeftAlt -- no PC, segure pra soltar o mouse
-- =========================

local ligado = false

-- botão
local gui = Instance.new("ScreenGui")
gui.Name = "ShiftLockUI"
gui.ResetOnSpawn = false
gui.DisplayOrder = 30
gui.Parent = player:WaitForChild("PlayerGui")

local botao = Instance.new("TextButton")
botao.AnchorPoint = Vector2.new(1, 1)
botao.Position = UDim2.new(1, -40, 1, -200) -- acima do botão de pulo
botao.Size = UDim2.new(0, 64, 0, 64)
botao.BackgroundColor3 = COR_DESLIGADO
botao.BorderSizePixel = 0
botao.Text = TEXTO
botao.TextColor3 = Color3.new(1, 1, 1)
botao.Font = Enum.Font.GothamBold
botao.TextSize = 16
botao.Parent = gui

local canto = Instance.new("UICorner")
canto.CornerRadius = UDim.new(1, 0)
canto.Parent = botao

-- lógica
local function pegar()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    return hum, hrp
end

local function liberarMouse()
    if not UserInputService.TouchEnabled then
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end

local function aplicar()
    local hum = pegar()
    if hum then
        hum.AutoRotate = not ligado
        hum.CameraOffset = ligado and DESLOCAMENTO or Vector3.zero
    end
    botao.BackgroundColor3 = ligado and COR_LIGADO or COR_DESLIGADO
    if not ligado then
        liberarMouse()
    end
end

botao.Activated:Connect(function()
    ligado = not ligado
    aplicar()
end)

RunService.RenderStepped:Connect(function()
    if not ligado then return end
    
    local hum, hrp = pegar()
    if not hum or not hrp then return end
    
    -- morto, deitado ou preso: solta o mouse pra poder clicar nos botões
    if hum.Health <= 0 or hum.PlatformStand or hrp.Anchored then
        liberarMouse()
        return
    end
    
    local olhar = camera.CFrame.LookVector
    local plano = Vector3.new(olhar.X, 0, olhar.Z)
    if plano.Magnitude > 0.01 then
        hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + plano)
    end
    
    -- no PC: mouse preso no centro, a não ser que você segure a tecla de liberar
    if not UserInputService.TouchEnabled then
        if UserInputService:IsKeyDown(TECLA_LIBERAR_MOUSE) then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        else
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        end
    end
end)

-- reaplica quando renascer
player.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid")
    aplicar()
end)

]]></ProtectedString>
