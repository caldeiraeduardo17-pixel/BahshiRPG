<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454103197AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">LootClient</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
 
local player = Players.LocalPlayer
local abrirRemote = ReplicatedStorage:WaitForChild("AbrirLoot")
local pegarRemote = ReplicatedStorage:WaitForChild("PegarLoot")
local avisoRemote = ReplicatedStorage:WaitForChild("AvisoLoot")
 
local inv = player:WaitForChild("Inventario")
local mochilaJogador = player:WaitForChild("Mochila")
local playerGui = player:WaitForChild("PlayerGui")
 
local DISTANCIA_FECHAR = 20 -- fecha o menu se você se afastar
 
-- ===== TELA =====
local gui = Instance.new("ScreenGui")
gui.Name = "LootUI"
gui.ResetOnSpawn = false
gui.DisplayOrder = 50
gui.Enabled = false
gui.Parent = playerGui
 
local painel = Instance.new("Frame")
painel.AnchorPoint = Vector2.new(0.5, 0.5)
painel.Position = UDim2.new(0.5, 0, 0.5, 0)
painel.Size = UDim2.new(0.7, 0, 0.7, 0)
painel.BackgroundColor3 = Color3.fromRGB(40, 33, 26)
painel.BorderSizePixel = 0
painel.Parent = gui
 
local function criarColuna(x, texto, margemDireita)
    local t = Instance.new("TextLabel")
    t.Position = UDim2.new(x, 8, 0, 8)
    t.Size = UDim2.new(0.5, -(8 + margemDireita), 0, 28)
    t.BackgroundTransparency = 1
    t.Text = texto
    t.TextColor3 = Color3.fromRGB(255, 220, 130)
    t.Font = Enum.Font.GothamBold
    t.TextSize = 18
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = painel
    
    local lista = Instance.new("ScrollingFrame")
    lista.Position = UDim2.new(x, 8, 0, 42)
    lista.Size = UDim2.new(0.5, -16, 1, -50)
    lista.BackgroundColor3 = Color3.fromRGB(25, 21, 17)
    lista.BorderSizePixel = 0
    lista.ScrollBarThickness = 6
    lista.CanvasSize = UDim2.new()
    lista.AutomaticCanvasSize = Enum.AutomaticSize.Y
    lista.Parent = painel
    
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 4)
    layout.Parent = lista
    
    return t, lista
end
 
local tituloMinha, listaMinha = criarColuna(0, "Sua mochila", 8)
local _, listaLoot = criarColuna(0.5, "Loot (toque no item pra pegar)", 48)
 
local fechar -- definida mais abaixo
 
local botaoX = Instance.new("TextButton")
botaoX.AnchorPoint = Vector2.new(1, 0)
botaoX.Position = UDim2.new(1, -8, 0, 8)
botaoX.Size = UDim2.new(0, 32, 0, 28)
botaoX.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
botaoX.BorderSizePixel = 0
botaoX.Text = "X"
botaoX.TextColor3 = Color3.new(1, 1, 1)
botaoX.Font = Enum.Font.GothamBold
botaoX.TextSize = 18
botaoX.Parent = painel
 
-- ===== AVISO =====
local avisoGui = Instance.new("ScreenGui")
avisoGui.Name = "LootAviso"
avisoGui.ResetOnSpawn = false
avisoGui.DisplayOrder = 60
avisoGui.Parent = playerGui
 
local aviso = Instance.new("TextLabel")
aviso.AnchorPoint = Vector2.new(0.5, 0)
aviso.Position = UDim2.new(0.5, 0, 0.12, 0)
aviso.Size = UDim2.new(0, 320, 0, 34)
aviso.BackgroundColor3 = Color3.new(0, 0, 0)
aviso.BackgroundTransparency = 0.4
aviso.TextColor3 = Color3.fromRGB(255, 120, 120)
aviso.Font = Enum.Font.GothamBold
aviso.TextSize = 18
aviso.Visible = false
aviso.Parent = avisoGui
 
local avisoId = 0
avisoRemote.OnClientEvent:Connect(function(msg)
    avisoId += 1
    local meu = avisoId
    aviso.Text = msg
    aviso.Visible = true
    task.delay(2, function()
        if meu == avisoId then
            aviso.Visible = false
        end
    end)
end)
 
-- ===== LÓGICA =====
local atual = nil
local ultima = ""
 
local function linha(lista, texto, aoClicar)
    local b = Instance.new(aoClicar and "TextButton" or "TextLabel")
    b.Size = UDim2.new(1, -8, 0, 36)
    b.BackgroundColor3 = Color3.fromRGB(65, 54, 43)
    b.BorderSizePixel = 0
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 16
    b.Text = texto
    b.Parent = lista
    if aoClicar then
        b.Activated:Connect(aoClicar)
    end
end
 
local function limpar(lista)
    for _, f in ipairs(lista:GetChildren()) do
        if f:IsA("GuiObject") then
            f:Destroy()
        end
    end
end
 
local function redesenhar()
    limpar(listaMinha)
    for _, item in ipairs(inv:GetChildren()) do
        linha(listaMinha, item.Name .. "  x" .. item.Value)
    end
    tituloMinha.Text = "Sua mochila  " .. mochilaJogador.SlotsUsados.Value
    .. " / " .. mochilaJogador.SlotsTotal.Value
    
    limpar(listaLoot)
    local m = atual
    if not m or not m.Parent then return end
    
    local ouro = m:FindFirstChild("Ouro")
    if ouro and ouro.Value > 0 then
        linha(listaLoot, "Ouro  x" .. ouro.Value, function()
            pegarRemote:FireServer(m, "__OURO")
        end)
    end
    
    local pasta = m:FindFirstChild("Itens")
    if pasta then
        for _, item in ipairs(pasta:GetChildren()) do
            local nome = item.Name
            linha(listaLoot, nome .. "  x" .. item.Value, function()
                pegarRemote:FireServer(m, nome)
            end)
        end
    end
end
 
local function assinatura()
    local p = {mochilaJogador.SlotsUsados.Value .. "/" .. mochilaJogador.SlotsTotal.Value}
    for _, i in ipairs(inv:GetChildren()) do
        table.insert(p, i.Name .. "=" .. i.Value)
    end
    if atual and atual.Parent then
        local o = atual:FindFirstChild("Ouro")
        table.insert(p, "ouro=" .. (o and o.Value or 0))
        local pasta = atual:FindFirstChild("Itens")
        if pasta then
            for _, i in ipairs(pasta:GetChildren()) do
                table.insert(p, "L" .. i.Name .. "=" .. i.Value)
            end
        end
    end
    return table.concat(p, ";")
end
 
fechar = function()
    gui.Enabled = false
    atual = nil
    ultima = ""
end
 
botaoX.Activated:Connect(fechar)
 
abrirRemote.OnClientEvent:Connect(function(mochila)
    if typeof(mochila) ~= "Instance" then return end
    atual = mochila
    ultima = ""
    gui.Enabled = true
end)
 
-- atualiza o menu e fecha se a mochila sumir ou você se afastar
task.spawn(function()
    while true do
        if gui.Enabled then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not atual or not atual.Parent or not hrp
                or not hum or hum.Health <= 0
                or (hrp.Position - atual.Position).Magnitude > DISTANCIA_FECHAR then
                fechar()
            else
                local s = assinatura()
                if s ~= ultima then
                    ultima = s
                    redesenhar()
                end
            end
        end
        task.wait(0.2)
    end
end)
 
 

]]></ProtectedString>
