<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[local RunService = game:GetService("RunService")
local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")
 
local Animacao = {}
 
local cache = {}                                   -- Animation já criadas
local trilhas = setmetatable({}, {__mode = "k"})   -- [animator][animation] = AnimationTrack
local avisouKeyframe = false
 
local function normalizarId(id)
    local s = tostring(id or "")
    s = s:gsub("%s", "")
    if s == "" or s == "0" then
        return nil
    end
    if tonumber(s) then
        return "rbxassetid://" .. s
    end
    return s
end
 
local function obterAnimation(opcoes)
    -- OPÇÃO 1: ID da animação publicada
    local id = normalizarId(opcoes.id)
    if id then
        local a = cache[id]
        if not a then
            a = Instance.new("Animation")
            a.Name = "AnimacaoID"
            a.AnimationId = id
            cache[id] = a
        end
        return a
    end
    
    -- OPÇÃO 2: KeyframeSequence (só funciona no teste do Studio)
    local ks = opcoes.keyframe
    if typeof(ks) == "Instance" and ks:IsA("KeyframeSequence") then
        if not RunService:IsStudio() and not avisouKeyframe then
            avisouKeyframe = true
            warn("Animacao: KeyframeSequence só funciona no teste do Studio. No jogo publicado, publique a animação e use o ID.")
        end
        
        local a = cache[ks]
        if not a then
            local ok, resultado = pcall(function()
                return KeyframeSequenceProvider:RegisterKeyframeSequence(ks)
            end)
            if not ok then
                warn("Animacao: não consegui registrar o KeyframeSequence: " .. tostring(resultado))
                return nil
            end
            a = Instance.new("Animation")
            a.Name = "AnimacaoKeyframe"
            a.AnimationId = resultado
            cache[ks] = a
        end
        return a
    end
    
    return nil
end
 
local function obterTrilha(animator, anim)
    local porAnimator = trilhas[animator]
    if not porAnimator then
        porAnimator = {}
        trilhas[animator] = porAnimator
    end
    
    local t = porAnimator[anim]
    if not t then
        t = animator:LoadAnimation(anim)
        porAnimator[anim] = t
    end
    return t
end
 
-- Toca a animação no personagem.
-- opcoes: id, keyframe, velocidade, prioridade, loop, fade
function Animacao.tocar(humanoid, opcoes)
    if not humanoid or not opcoes then return nil end
    
    local anim = obterAnimation(opcoes)
    if not anim then return nil end
    
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    
    local ok, trilha = pcall(obterTrilha, animator, anim)
    if not ok or not trilha then
        warn("Animacao: falha ao carregar a animação (ID errado ou sem permissão?)")
        return nil
    end
    
    trilha.Priority = opcoes.prioridade or Enum.AnimationPriority.Action2
    trilha.Looped = opcoes.loop == true
    trilha:Play(opcoes.fade or 0.1, 1, opcoes.velocidade or 1)
    return trilha
end
 
return Animacao

]]></ProtectedString>
