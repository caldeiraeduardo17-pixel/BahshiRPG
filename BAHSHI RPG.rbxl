<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
 
local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("ConfigPersonagem"))
local abrirRemote = ReplicatedStorage:WaitForChild("AbrirArmario")
local trocarRemote = ReplicatedStorage:WaitForChild("TrocarAparencia")
local aparencia = player:WaitForChild("Aparencia")
 
-- ===== CONFIGURAÇÕES =====
local DISTANCIA_FECHAR = 20 -- fecha o menu se você se afastar
local COR_FUNDO = Color3.fromRGB(40, 33, 26)
local COR_BOTAO = Color3.fromRGB(110, 80, 40)
local COR_TEXTO = Color3.fromRGB(255, 230, 170)
-- =========================
 
local function novo(classe, props, pai)
    local o = Instance.new(classe)
    for k, v in pairs(props) do
        o[k] = v
    end
    o.Parent = pai
    return o
end
 
local function botaoPadrao(texto, props, pai)
    local p = {
    Text = texto,
    BackgroundColor3 = COR_BOTAO,
    BorderSizePixel = 0,
    TextColor3 = Color3.new(1, 1, 1),
    Font = Enum.Font.GothamBold,
    TextSize = 20,
    }
    for k, v in pairs(props) do
        p[k] = v
    end
    return novo("TextButton", p, pai)
end
 
-- No ViewportFrame não existe física, então os acessórios (cabelo) não
-- "grudam" sozinhos. Aqui cada acessório é posicionado pela solda dele.
local function ajustarAcessorios(modelo)
    for _, acessorio in ipairs(modelo:GetChildren()) do
        if acessorio:IsA("Accessory") then
            local handle = acessorio:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then
                local solda = handle:FindFirstChildOfClass("Weld")
                if solda and solda.Part0 and solda.Part1 then
                    if solda.Part0 == handle then
                        handle.CFrame = solda.Part1.CFrame * solda.C1 * solda.C0:Inverse()
                    elseif solda.Part1 == handle then
                        handle.CFrame = solda.Part0.CFrame * solda.C0 * solda.C1:Inverse()
                    end
                else
                    -- sem solda: usa o attachment de mesmo nome no corpo
                    local att = handle:FindFirstChildOfClass("Attachment")
                    local alvo = att and modelo:FindFirstChild(att.Name, true)
                    if alvo and alvo:IsA("Attachment") then
                        handle.CFrame = alvo.WorldCFrame * att.CFrame:Inverse()
                    end
                end
            end
        end
    end
end
 
local gui = novo("ScreenGui", {
Name = "ArmarioUI",
ResetOnSpawn = false,
DisplayOrder = 45,
Enabled = false,
}, player:WaitForChild("PlayerGui"))
 
local painel = novo("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.new(0.5, 0, 0.5, 0),
Size = UDim2.new(0.8, 0, 0.82, 0),
BackgroundColor3 = COR_FUNDO,
BorderSizePixel = 0,
Active = true,
}, gui)
 
novo("TextLabel", {
Position = UDim2.new(0, 0, 0.02, 0),
Size = UDim2.new(1, 0, 0, 36),
BackgroundTransparency = 1,
Text = "Armário",
TextColor3 = COR_TEXTO,
Font = Enum.Font.GothamBlack,
TextSize = 26,
}, painel)
 
-- prévia 3D
local viewport = novo("ViewportFrame", {
Position = UDim2.new(0.03, 0, 0.15, 0),
Size = UDim2.new(0.35, 0, 0.7, 0),
BackgroundColor3 = Color3.fromRGB(30, 24, 19),
BorderSizePixel = 0,
Ambient = Color3.fromRGB(190, 190, 190),
LightColor = Color3.new(1, 1, 1),
LightDirection = Vector3.new(0, -0.3, 1),
}, painel)
 
local camPreview = novo("Camera", {FieldOfView = 40}, viewport)
camPreview.CFrame = CFrame.lookAt(Vector3.new(0, 3, -10), Vector3.new(0, 2.7, 0))
viewport.CurrentCamera = camPreview
 
-- estado
local escolha = {pele = 1, cabelo = 1, roupa = 1}
local nomes = {}
local bordas = {}
local modeloPreview = nil
local versao = 0
local angulo = 0
local alvo = nil -- Part do armário aberto
 
local function atualizarSelecao()
    for i, borda in ipairs(bordas) do
        borda.Enabled = (i == escolha.pele)
    end
    nomes.cabelo.Text = Config.CABELOS[escolha.cabelo].nome
    nomes.roupa.Text = Config.CONJUNTOS[escolha.roupa].nome
end
 
local function atualizarPreview()
    versao += 1
    local minha = versao
 
    task.spawn(function()
        local desc = Config.montarDescricao(escolha.pele, escolha.cabelo, escolha.roupa)
        local ok, modelo = pcall(function()
            return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
        end)
        if not ok then
            warn("ArmarioClient: prévia falhou: " .. tostring(modelo))
            return
        end
        if minha ~= versao or not gui.Enabled then
            modelo:Destroy()
            return
        end
        if modeloPreview then
            modeloPreview:Destroy()
        end
        modeloPreview = modelo
        modeloPreview:PivotTo(CFrame.new(0, 3, 0) * CFrame.Angles(0, angulo, 0))
        ajustarAcessorios(modeloPreview)
        modeloPreview.Parent = viewport
    end)
end
 
RunService.RenderStepped:Connect(function(dt)
    if modeloPreview and gui.Enabled then
        angulo += dt * 0.8
        modeloPreview:PivotTo(CFrame.new(0, 3, 0) * CFrame.Angles(0, angulo, 0))
    end
end)
 
-- opções
local opcoes = novo("ScrollingFrame", {
Position = UDim2.new(0.42, 0, 0.15, 0),
Size = UDim2.new(0.55, 0, 0.6, 0),
BackgroundTransparency = 1,
BorderSizePixel = 0,
ScrollBarThickness = 6,
CanvasSize = UDim2.new(),
AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, painel)
 
novo("UIListLayout", {
Padding = UDim.new(0, 10),
SortOrder = Enum.SortOrder.LayoutOrder,
}, opcoes)
 
local function rotulo(texto, ordem)
    novo("TextLabel", {
    LayoutOrder = ordem,
    Size = UDim2.new(1, -10, 0, 22),
    BackgroundTransparency = 1,
    Text = texto,
    TextColor3 = COR_TEXTO,
    Font = Enum.Font.GothamBold,
    TextSize = 16,
    TextXAlignment = Enum.TextXAlignment.Left,
    }, opcoes)
end
 
rotulo("Tom de pele", 1)
 
local grade = novo("Frame", {
LayoutOrder = 2,
Size = UDim2.new(1, -10, 0, 0),
AutomaticSize = Enum.AutomaticSize.Y,
BackgroundTransparency = 1,
}, opcoes)
 
novo("UIGridLayout", {
CellSize = UDim2.new(0, 36, 0, 36),
CellPadding = UDim2.new(0, 8, 0, 8),
SortOrder = Enum.SortOrder.LayoutOrder,
}, grade)
 
for i, p in ipairs(Config.PELES) do
    local b = novo("TextButton", {
    LayoutOrder = i,
    BackgroundColor3 = p.cor,
    BorderSizePixel = 0,
    Text = "",
    }, grade)
 
    bordas[i] = novo("UIStroke", {
    Thickness = 3,
    Color = Color3.new(1, 1, 1),
    ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    Enabled = false,
    }, b)
 
    b.Activated:Connect(function()
        escolha.pele = i
        atualizarSelecao()
        atualizarPreview()
    end)
end
 
local function criarSeletor(titulo, ordem, lista, chave)
    rotulo(titulo, ordem)
 
    local linha = novo("Frame", {
    LayoutOrder = ordem + 1,
    Size = UDim2.new(1, -10, 0, 40),
    BackgroundTransparency = 1,
    }, opcoes)
 
    local esq = botaoPadrao("<", {Size = UDim2.new(0, 44, 1, 0)}, linha)
    local dir = botaoPadrao(">", {
    AnchorPoint = Vector2.new(1, 0),
    Position = UDim2.new(1, 0, 0, 0),
    Size = UDim2.new(0, 44, 1, 0),
    }, linha)
 
    local nome = novo("TextLabel", {
    Position = UDim2.new(0, 52, 0, 0),
    Size = UDim2.new(1, -104, 1, 0),
    BackgroundColor3 = Color3.fromRGB(50, 42, 34),
    BorderSizePixel = 0,
    TextColor3 = Color3.new(1, 1, 1),
    Font = Enum.Font.GothamMedium,
    TextSize = 16,
    TextWrapped = true,
    }, linha)
 
    local function mudar(d)
        escolha[chave] = (escolha[chave] - 1 + d) % #lista + 1
        atualizarSelecao()
        atualizarPreview()
    end
 
    esq.Activated:Connect(function() mudar(-1) end)
        dir.Activated:Connect(function() mudar(1) end)
 
            return nome
        end
 
        nomes.cabelo = criarSeletor("Cabelo", 3, Config.CABELOS, "cabelo")
        nomes.roupa = criarSeletor("Conjunto de roupa", 5, Config.CONJUNTOS, "roupa")
 
        -- botões
        local function fechar()
            gui.Enabled = false
            alvo = nil
            versao += 1
            if modeloPreview then
                modeloPreview:Destroy()
                modeloPreview = nil
            end
        end
 
        botaoPadrao("Confirmar", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(0.97, 0, 0.97, 0),
        Size = UDim2.new(0, 170, 0, 44),
        }, painel).Activated:Connect(function()
            trocarRemote:FireServer(escolha.pele, escolha.cabelo, escolha.roupa)
            fechar()
        end)
 
        botaoPadrao("Cancelar", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(0.97, -182, 0.97, 0),
        Size = UDim2.new(0, 150, 0, 44),
        BackgroundColor3 = Color3.fromRGB(70, 58, 46),
        }, painel).Activated:Connect(fechar)
 
        -- abrir
        abrirRemote.OnClientEvent:Connect(function(parte)
            if typeof(parte) ~= "Instance" then return end
 
            alvo = parte
            escolha.pele = math.clamp(aparencia.Pele.Value, 1, #Config.PELES)
            escolha.cabelo = math.clamp(aparencia.Cabelo.Value, 1, #Config.CABELOS)
            escolha.roupa = math.clamp(aparencia.Roupa.Value, 1, #Config.CONJUNTOS)
 
            gui.Enabled = true
            atualizarSelecao()
            atualizarPreview()
        end)
 
        -- fecha se você morrer, tomar dano ou se afastar
        task.spawn(function()
            local vidaAntes = 0
            while true do
                if gui.Enabled then
                    local char = player.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
 
                    if not hum or not hrp or hum.Health <= 0
                        or not alvo or not alvo.Parent
                        or (hrp.Position - alvo.Position).Magnitude > DISTANCIA_FECHAR
                        or hum.Health < vidaAntes - 0.01 then
                        fechar()
                    else
                        vidaAntes = hum.Health
                    end
                else
                    vidaAntes = 0
                end
                task.wait(0.25)
            end
        end)

]]></ProtectedString>
