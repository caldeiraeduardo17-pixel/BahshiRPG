<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
 
local function xpPraProximo(nivel)
    return nivel * 100
end
 
Players.PlayerAdded:Connect(function(player)
    local stats = Instance.new("Folder")
    stats.Name = "leaderstats"
    stats.Parent = player
    
    local nivel = Instance.new("IntValue")
    nivel.Name = "Nivel"
    nivel.Value = 1
    nivel.Parent = stats
    
    local xp = Instance.new("IntValue")
    xp.Name = "XP"
    xp.Parent = stats
    
    local ouro = Instance.new("IntValue")
    ouro.Name = "Ouro"
    ouro.Parent = stats
    
    xp.Changed:Connect(function()
        while xp.Value >= xpPraProximo(nivel.Value) do
            xp.Value = xp.Value - xpPraProximo(nivel.Value)
            nivel.Value = nivel.Value + 1
        end
    end)
end)

]]></ProtectedString>
