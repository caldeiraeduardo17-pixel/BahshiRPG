<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454103225AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">VidaScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local player = Players.LocalPlayer

local hud = script.Parent
local fundo = hud:WaitForChild("VidaFundo")
local barra = fundo:WaitForChild("VidaBarra")
local texto = fundo:WaitForChild("VidaTexto")

local function ligar(char)
    local hum = char:WaitForChild("Humanoid")
    
    local function atualizar()
        local vida = math.max(0, math.ceil(hum.Health))
        local maxima = math.max(1, math.ceil(hum.MaxHealth))
        texto.Text = vida .. " / " .. maxima
        barra.Size = UDim2.new(math.clamp(vida / maxima, 0, 1), 0, 1, 0)
    end
    
    hum.HealthChanged:Connect(atualizar)
    hum:GetPropertyChangedSignal("MaxHealth"):Connect(atualizar)
    atualizar()
    
    -- garante que o valor certo apareça logo no início
    task.spawn(function()
        while hum.Parent do
            atualizar()
            task.wait(0.25)
        end
    end)
end

if player.Character then ligar(player.Character) end
player.CharacterAdded:Connect(ligar)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940322600437f</UniqueId>
</Properties>
