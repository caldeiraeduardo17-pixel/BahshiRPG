<Item class="Script" referent="RBX66C1625455D04AC580D8103329513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Lojas</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
 
-- ===== CONFIGURAÇÕES =====
local PREFIXO = "Loja_"
local TEMPO_SEGURAR = 0    -- segundos segurando pra abrir (0 = toque rápido)
local DISTANCIA_MAX = 15   -- distância máxima pra comprar/vender
local QTD_MAX = 999
-- =========================
 
-- carrega o ConfigLojas sem travar o script
local modulo = ReplicatedStorage:WaitForChild("ConfigLojas", 10)
if not modulo then
    warn("Lojas: não achei o ModuleScript 'ConfigLojas' em ReplicatedStorage")
    return
end
 
local okConfig, Config = pcall(require, modulo)
if not okConfig then
    warn("Lojas: erro dentro do ConfigLojas: " .. tostring(Config))
    return
end
 
local function criarRemote(nome)
    local r = Instance.new("RemoteEvent")
    r.Name = nome
    r.Parent = ReplicatedStorage
    return r
end
 
local abrirRemote = criarRemote("AbrirLoja")
local transacaoRemote = criarRemote("TransacaoLoja")
local avisoRemote = criarRemote("AvisoLoja")
 
local npcs = {} -- {id = "Ferreiro", parte = Part}
 
local function estaVivo(jogador)
    local char = jogador.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end
 
local function aviso(jogador, texto, ok)
    avisoRemote:FireClient(jogador, texto, ok)
end
 
local function configurarLoja(modelo)
    if not modelo:IsA("Model") then return end
    
    local id = string.match(modelo.Name, "^" .. PREFIXO .. "(.+)$")
    if not id then return end
    
    local dados = Config[id]
    if not dados then
        warn("Lojas: não existe a loja '" .. id .. "' no ConfigLojas")
        return
    end
    
    local hum = modelo:FindFirstChildOfClass("Humanoid")
    local raiz = modelo:FindFirstChild("HumanoidRootPart")
    or modelo.PrimaryPart
    or modelo:FindFirstChildWhichIsA("BasePart", true)
    if not raiz then
        warn("Lojas: o NPC " .. modelo.Name .. " não tem nenhuma Part")
        return
    end
    if raiz:FindFirstChildOfClass("ProximityPrompt") then return end
    
    -- fica parado e não leva dano
    raiz.Anchored = true
    if hum then
        hum.WalkSpeed = 0
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    end
    local ff = Instance.new("ForceField")
    ff.Visible = false
    ff.Parent = modelo
    
    -- nome em cima da cabeça
    local gui = Instance.new("BillboardGui")
    gui.Adornee = modelo:FindFirstChild("Head") or raiz
    gui.Size = UDim2.new(0, 140, 0, 24)
    gui.StudsOffset = Vector3.new(0, 2.5, 0)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 60
    gui.Parent = raiz
    
    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = dados.nome or id
    txt.TextColor3 = Color3.fromRGB(255, 230, 170)
    txt.TextStrokeTransparency = 0.3
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 16
    txt.Parent = gui
    
    -- botão de interagir
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = "Conversar"
    prompt.ObjectText = dados.nome or id
    prompt.HoldDuration = TEMPO_SEGURAR
    prompt.MaxActivationDistance = 8
    prompt.RequiresLineOfSight = false
    prompt.Parent = raiz
    
    table.insert(npcs, {id = id, parte = raiz})
    print("Lojas: loja configurada -> " .. id)
    
    prompt.Triggered:Connect(function(jogador)
        if not estaVivo(jogador) then return end
        abrirRemote:FireClient(jogador, id, raiz)
    end)
end
 
for _, obj in ipairs(workspace:GetDescendants()) do
    configurarLoja(obj)
end
workspace.DescendantAdded:Connect(configurarLoja)
 
local function pertoDaLoja(jogador, id)
    local char = jogador.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    for _, n in ipairs(npcs) do
        if n.id == id and n.parte.Parent
            and (n.parte.Position - hrp.Position).Magnitude <= DISTANCIA_MAX then
            return true
        end
    end
    return false
end
 
local function achar(lista, item)
    for _, e in ipairs(lista or {}) do
        if e.item == item then
            return e
        end
    end
    return nil
end
 
transacaoRemote.OnServerEvent:Connect(function(jogador, id, acao, item, qtd)
    if type(id) ~= "string" or type(acao) ~= "string"
        or type(item) ~= "string" or type(qtd) ~= "number" then
        return
    end
    
    qtd = math.floor(qtd)
    if qtd < 1 or qtd > QTD_MAX then return end
    
    local loja = Config[id]
    if not loja or not estaVivo(jogador) or not pertoDaLoja(jogador, id) then return end
    
    local stats = jogador:FindFirstChild("leaderstats")
    if not stats then return end
    
    local darItem = ServerStorage:FindFirstChild("DarItem")
    local tirarItem = ServerStorage:FindFirstChild("TirarItem")
    if not darItem or not tirarItem then
        warn("Lojas: faltam DarItem/TirarItem no ServerStorage (vêm do script Inventario)")
        aviso(jogador, "Loja indisponível", false)
        return
    end
    
    if acao == "comprar" then
        local e = achar(loja.vende, item)
        if not e then return end
        local preco = math.max(1, math.floor(e.preco))
        
        local quantos = math.min(qtd, math.floor(stats.Ouro.Value / preco))
        if quantos < 1 then
            aviso(jogador, "Ouro insuficiente", false)
            return
        end
        
        -- só cobra o que realmente coube na mochila
        local recebeu = darItem:Invoke(jogador, item, quantos)
        if recebeu < 1 then
            aviso(jogador, "Mochila cheia", false)
            return
        end
        
        stats.Ouro.Value -= recebeu * preco
        aviso(jogador, "Comprou " .. recebeu .. "x " .. item, true)
        
    elseif acao == "vender" then
        local e = achar(loja.compra, item)
        if not e then return end
        local preco = math.max(1, math.floor(e.preco))
        
        local tirou = tirarItem:Invoke(jogador, item, qtd)
        if tirou < 1 then return end
        
        stats.Ouro.Value += tirou * preco
        aviso(jogador, "Vendeu " .. tirou .. "x " .. item, true)
    end
end)

]]></ProtectedString>
