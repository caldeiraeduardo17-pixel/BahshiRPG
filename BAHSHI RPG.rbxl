<Content name="LinkedSource"><null></null></Content>
<string name="Name">MúsicaFundo</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
 
-- ===== CONFIGURAÇÕES =====
local MUSICAS = {
"123635624345930",
"89872124612458",
"129683846809962", -- cole seus IDs aqui
}
local VOLUME = 0.2
local ALEATORIA = true
local FADE = 2
local PAUSA_ENTRE = 3
-- =========================
 
local lista = {}
for _, id in ipairs(MUSICAS) do
    id = (tostring(id):gsub("%s", ""))
    if id ~= "" then
        if tonumber(id) then
            id = "rbxassetid://" .. id
        end
        table.insert(lista, id)
    end
end
 
print("MusicaFundo: iniciou com " .. #lista .. " música(s)")
if #lista == 0 then
    warn("MusicaFundo: nenhuma música na lista (confira os IDs)")
    return
end
 
local musica = Instance.new("Sound")
musica.Name = "MusicaDeFundo"
musica.Volume = 0
musica.Parent = SoundService
 
local indice = 0
 
while true do
    if #lista == 1 then
        indice = 1
    elseif ALEATORIA then
        local novo
        repeat
        novo = math.random(#lista)
        until novo ~= indice
        indice = novo
    else
        indice = indice % #lista + 1
    end
    
    local id = lista[indice]
    musica.SoundId = id
    musica.Volume = 0
    musica:Play()
    print("MusicaFundo: tentando tocar " .. id)
    
    local espera = 0
    while not musica.IsLoaded and espera < 15 do
        task.wait(0.2)
        espera += 0.2
    end
    
    if musica.IsLoaded and musica.TimeLength > 0 then
        print("MusicaFundo: tocando! duração " .. math.floor(musica.TimeLength) .. "s")
        TweenService:Create(musica, TweenInfo.new(FADE), {Volume = VOLUME}):Play()
        task.wait(math.max(0, musica.TimeLength - FADE))
        TweenService:Create(musica, TweenInfo.new(FADE), {Volume = 0}):Play()
        task.wait(FADE)
        musica:Stop()
        task.wait(PAUSA_ENTRE)
    else
        warn("MusicaFundo: NÃO carregou " .. id .. " (ID errado ou áudio não liberado)")
        musica:Stop()
        task.wait(5)
    end
end

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940319000437f</UniqueId>
